# Frontend (Vite). Copy to .env.local. Only VITE_-prefixed vars reach the app.
#
# MSW mocks are ON by default in development. Set false to hit the real Go gateway
# with Clerk auth. Vite proxies /api -> VITE_API_URL (see vite.config.ts).
#
# Production builds still call same-origin `/api` (src/api/client.ts). VITE_API_URL
# is the *dev proxy target only* — it is not baked into the bundle. Point the
# SPA hostname's /api at the Go gateway (Cloudflare rewrite or tunnel); see
# openwiki/deployment-runbook.md §1.
VITE_USE_MSW=true

VITE_PORT=5173
VITE_API_URL=http://localhost:8080

# Clerk (required when VITE_USE_MSW=false)
VITE_CLERK_PUBLISHABLE_KEY=

# Google Picker (same GCP project as the Clerk Google OAuth client).
# API key + Cloud project number. Missing either fails the picker closed.
# VITE_GOOGLE_PICKER_API_KEY=
# VITE_GOOGLE_PICKER_APP_ID=

# OneDrive File Picker v8 (Entra SPA public client, not the Clerk Microsoft app).
# Redirect URI is {SPA origin}/msal-redirect.html. See openwiki/deployment-runbook.md §11.
# VITE_MSAL_CLIENT_ID=
# Optional tenant authority if common/organizations is wrong for a school tenant.
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# Optional — Stripe.js not used yet; checkout redirects server-side
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional — Direct B2 upload. If true, the app will upload files directly to B2 instead of using the proxy.
# This is useful if you want to bypass the proxy and upload files directly to B2.
VITE_DIRECT_B2_UPLOAD=true

# Observability. Empty disables. The SPA DSN is public — use a browser-only
# Sentry project, never the gateway DSN. PostHog authorized URLs must be the
# production SPA origin only.
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_APP_ENV=development
# VITE_RELEASE_SHA=

# Feature flags (build-time). Defaults are off.
# VITE_FEATURE_EXPLORE=false
# VITE_FEATURE_THINKING=false
# VITE_FEATURE_EDITOR_AI=false
# VITE_FEATURE_SCHEDULE=false
# VITE_FEATURE_TASKS=false

VITE_LOAD_TEST_SEED=false

# Optional separate origin for llm-runtime.html. Leave empty: the app embeds
# a same-origin iframe. Chrome 137+ isolates that document via
# Document-Isolation-Policy without isolating the SPA. Set this only if you
# still want a second hostname, e.g. https://llm.abcd.com
# VITE_LLM_RUNTIME_ORIGIN=
# VITE_APP_URL=https://abcd.com
