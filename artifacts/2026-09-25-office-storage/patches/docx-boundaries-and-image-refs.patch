+
+/// SHRINK PROTOTYPE: replace `media:<part>` image sources in lowered blocks.
+fn resolve_media_refs(
+    blocks: &mut [docx_layout::types::LayoutBlock],
+    media: &std::collections::HashMap<String, String>,
+) {
+    use docx_layout::types::{LayoutBlock, ParagraphBlock, Run};
+    let resolve = |src: &mut String| {
+        if let Some(path) = src.strip_prefix("media:")
+            && let Some(url) = media.get(path)
+        {
+            *src = url.clone();
+        }
+    };
+    let paragraph = |block: &mut ParagraphBlock| {
+        for run in &mut block.runs {
+            if let Run::Image(image) = run {
+                resolve(&mut image.src);
+            }
+        }
+    };
+    for block in blocks {
+        match block {
+            LayoutBlock::Paragraph(block) => paragraph(block),
+            LayoutBlock::Image(block) => resolve(&mut block.src),
+            LayoutBlock::Table(table) => {
+                for row in &mut table.rows {
+                    for cell in &mut row.cells {
+                        resolve_media_refs(&mut cell.blocks, media);
+                    }
+                }
+            }
+            LayoutBlock::TextBox(text_box) => text_box.content.iter_mut().for_each(paragraph),
+            _ => {}
+        }
+    }
 }
 
