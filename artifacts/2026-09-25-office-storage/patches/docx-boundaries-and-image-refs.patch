+/// SHRINK PROTOTYPE: package media keyed by a hash of its data URL, so a
+/// seeded image can name its part instead of carrying the bytes.
+pub(crate) type MediaPaths = std::collections::HashMap<u64, String>;
+
+pub(crate) fn media_key(data_url: &str) -> u64 {
+    let mut hash = 0xcbf2_9ce4_8422_2325_u64;
+    for byte in data_url.as_bytes() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
+    }
+    hash ^ (data_url.len() as u64).rotate_left(32)
+}
+
+pub(crate) const MEDIA_REF_PREFIX: &str = "media:";
