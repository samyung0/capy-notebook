@@ -0,0 +1,81 @@
+//! Scratch probe (cross-shrink): seed size, open costs and an edit round trip.
+//! cargo run --release -p betteroffice-pptx-edit --example state_size -- deck.pptx...
+use std::collections::BTreeMap;
+use std::time::Instant;
+
+use pptx_edit::{DeckSession, EditCtx, TextStyle};
+
+fn parts(bytes: &[u8]) -> BTreeMap<String, Vec<u8>> {
+    ooxml_opc::unzip_parts(bytes).unwrap().into_iter().collect()
+}
+
+fn ms(start: Instant) -> f64 {
+    (start.elapsed().as_secs_f64() * 1000.0 * 10.0).round() / 10.0
+}
+
+fn main() {
+    for path in std::env::args().skip(1) {
+        let bytes = std::fs::read(&path).unwrap();
+        let t = Instant::now();
+        let seeded = DeckSession::open(&bytes, 7).unwrap();
+        let t_seed = ms(t);
+        let state = seeded.encode_state_as_update_v1();
+        if let Ok(dir) = std::env::var("STATE_DUMP_DIR") {
+            let name = path.rsplit(['/', '\\']).next().unwrap();
+            std::fs::write(format!("{dir}/{name}.state.bin"), &state).unwrap();
+        }
+
+        // Open from the stored state with the fingerprinted source, as every
+        // Capy path does (browser editor, headless checkpoint runtime).
+        let t = Instant::now();
+        let reopened = DeckSession::open_from_update_with_source(&state, &bytes, 8).unwrap();
+        let t_open = ms(t);
+
+        // One local edit on the first text story, shipped as an update.
+        let snapshot = reopened.snapshot().unwrap();
+        let story = snapshot
+            .slides
+            .iter()
+            .flat_map(|slide| slide.shapes.iter())
+            .flat_map(|shape| shape.text_stories.iter())
+            .next()
+            .map(|story| story.id.clone());
+        let before_vector = reopened.encode_state_vector_v1();
+        if let Some(story) = &story {
+            reopened
+                .insert_text(&EditCtx::local("probe"), story, 0, "Probe ", &TextStyle::default())
+                .unwrap();
+        }
+        let edited_state = reopened.encode_state_as_update_v1();
+        let update = reopened.encode_diff_v1(&before_vector).unwrap();
+
+        // A peer applying that update (validation path of every remote update).
+        let peer = DeckSession::open_from_update_with_source(&state, &bytes, 9).unwrap();
+        let t = Instant::now();
+        peer.apply_update_v1(&update).unwrap();
+        let t_apply = ms(t);
+
+        // Save from a fresh open of the edited state must equal the editing session's save.
+        let t = Instant::now();
+        let from_state = DeckSession::open_from_update_with_source(&edited_state, &bytes, 10)
+            .unwrap()
+            .save()
+            .unwrap();
+        let t_save = ms(t);
+        let direct = reopened.save().unwrap();
+        let same = parts(&from_state) == parts(&direct);
+        println!(
+            "{{\"file\":{:?},\"source\":{},\"state\":{},\"editedState\":{},\"update\":{},\"seedMs\":{},\"openWithSourceMs\":{},\"applyRemoteUpdateMs\":{},\"openAndSaveMs\":{},\"saveRoundTripEqual\":{}}}",
+            path.rsplit(['/', '\\']).next().unwrap(),
+            bytes.len(),
+            state.len(),
+            edited_state.len(),
+            update.len(),
+            t_seed,
+            t_open,
+            t_apply,
+            t_save,
+            same
+        );
+    }
+}
