+/// LAZY PROTOTYPE. Net effects against the source package read from the
+/// overrides alone: one entry per overridden cell whose text or format differs
+/// from the source, one per active row or column change. No full projection.
+pub(super) fn override_effects(
+    doc: &Doc,
+    base: &WorkbookBase,
+    model: &WorkbookModel,
+) -> Result<Vec<serde_json::Value>, String> {
+    let txn = doc.transact();
+    let context = context(&txn)?;
+    let text = |cell: Option<&Cell>| -> Option<String> {
+        let cell = cell?;
+        match &cell.formula {
+            Some(formula) => Some(format!("={formula}")),
+            None if matches!(cell.value, CellValue::Empty) => None,
+            None => serde_json::to_string(&cell.value).ok(),
+        }
+    };
+    let mut effects = Vec::new();
+    for (index, key) in context.keys.iter().enumerate() {
+        let sheet = sheet_map(&txn, key)?;
+        let current = &model.sheets[index];
+        let name = &context.names[index];
+        let source = base_sheet_index(key).and_then(|index| base.sheets.get(index));
+        let source_cell = |cell_key: &str| -> Result<Option<&Cell>, String> {
+            Ok(match (source, base_point(cell_key)?) {
+                (Some(sheet), Some((row, col))) => sheet.cell(CellRef::new(row, col)),
+                _ => None,
+            })
+        };
+        for (cell_key, _) in nested_map(&sheet, &txn, CONTENTS)?.iter(&txn) {
+            let Some(at) = context.at(key, cell_key)? else {
+                continue;
+            };
+            let (before, after) = (text(source_cell(cell_key)?), text(current.cell(at)));
+            if before == after {
+                continue;
+            }
+            let operation = match (&before, &after) {
+                (None, _) => "add",
+                (_, None) => "remove",
+                _ => "replace",
+            };
+            let mut effect = serde_json::json!({
+                "id": format!("{key}:{cell_key}"), "kind": "text", "operation": operation,
+                "label": format!("{name}!{}", at.to_a1()),
+            });
+            if let Some(before) = before {
+                effect["before"] = before.into();
+            }
+            if let Some(after) = after {
+                effect["after"] = after.into();
+            }
+            effects.push(effect);
+        }
+        for (cell_key, _) in nested_map(&sheet, &txn, STYLES)?.iter(&txn) {
+            let Some(at) = context.at(key, cell_key)? else {
+                continue;
+            };
+            effects.push(serde_json::json!({
+                "id": format!("{key}:{cell_key}:format"), "kind": "visual", "operation": "replace",
+                "label": format!("{name}!{} formatting", at.to_a1()),
+            }));
+        }
+        for axis_name in [ROWS, COLS] {
+            let active = nested_map(&sheet, &txn, axis_name)?;
+            let catalog = nested_map(&nested_map(&map(&txn, CATALOG)?, &txn, key)?, &txn, axis_name)?;
+            for (id, _) in active.iter(&txn) {
+                let change: Change = decode(catalog.get(&txn, id).ok_or("missing axis change")?)?;
+                let (operation, count) = match change {
+                    Change::Insert { count, .. } => ("add", u64::from(count)),
+                    Change::Delete { spans } => ("remove", spans.iter().map(|span| span.len).sum()),
+                };
+                effects.push(serde_json::json!({
+                    "id": format!("{key}:{axis_name}:{id}"), "kind": "text", "operation": operation,
+                    "label": format!("{name}: {count} {axis_name} {}", if operation == "add" { "inserted" } else { "deleted" }),
+                }));
+            }
+        }
+    }
+    Ok(effects)
+}
