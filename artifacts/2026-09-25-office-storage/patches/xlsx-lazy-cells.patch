+fn base_bindings(base: &WorkbookBase) -> Result<&BaseBindings, String> {
+    base.bindings
+        .get_or_init(|| {
+            let context = initial_context(base)?;
+            let formulas = base
+                .sheets
+                .iter()
+                .enumerate()
+                .map(|(index, sheet)| {
+                    let key = format!("sheet:{index}");
+                    sheet
+                        .iter_cells()
+                        .filter_map(|(at, cell)| cell.formula.as_ref().map(|formula| (at, formula)))
+                        .map(|(at, formula)| {
+                            Ok(((at.row, at.col), Formula::bind(formula, Some(&key), &context)?))
+                        })
+                        .collect::<Result<HashMap<_, _>, String>>()
+                })
+                .collect::<Result<Vec<_>, String>>()?;
+            Ok(BaseBindings { formulas })
+        })
+        .as_ref()
+        .map_err(Clone::clone)
+}
