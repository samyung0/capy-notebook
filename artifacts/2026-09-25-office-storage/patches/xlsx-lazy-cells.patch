+/// LAZY PROTOTYPE. The parsed source cell an identity names, if both of its
+/// points lie on the source runs of a source sheet.
+fn base_cell<'a>(
+    base: &'a WorkbookBase,
+    context: &Context,
+    key: &str,
+    at: CellRef,
+) -> Result<Option<&'a Cell>, String> {
+    let Some(index) = base_sheet_index(key) else {
+        return Ok(None);
+    };
+    let (rows, cols) = context.axes(key)?;
+    let (row, col) = (rows.at(at.row)?, cols.at(at.col)?);
+    if row.run != "base"
+        || col.run != "base"
+        || row.offset >= u64::from(MAX_ROWS)
+        || col.offset >= u64::from(MAX_COLS)
+    {
+        return Ok(None);
+    }
+    Ok(base
+        .sheets
+        .get(index)
+        .and_then(|sheet| sheet.cell(CellRef::new(row.offset as u32, col.offset as u32))))
+}
+
+fn base_point(key: &str) -> Result<Option<(u32, u32)>, String> {
+    let (row, col): (Point, Point) =
+        serde_json::from_str(key).map_err(|error| format!("invalid stable cell key: {error}"))?;
+    Ok((row.run == "base"
+        && col.run == "base"
+        && row.offset < u64::from(MAX_ROWS)
+        && col.offset < u64::from(MAX_COLS))
+    .then_some((row.offset as u32, col.offset as u32)))
+}
