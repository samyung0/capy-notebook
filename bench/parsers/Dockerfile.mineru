# MinerU pipeline backend on CPU — the control in the comparison.
#
# Deliberately a SEPARATE image from the Marker/Docling one. MinerU pins its own
# surya + transformers versions and Marker v2 pins different ones; installing
# both in one environment resolves to something neither project tests, and a
# dependency-resolution artifact would be indistinguishable from a real result.
#
#   docker build -f bench/parsers/Dockerfile.mineru -t evo-parse-bench-mineru bench/parsers
#   docker run --rm --cpus=4 \
#     -v "$PWD/bench/parsers/out/cpu4/_capped:/bench/docs:ro" \
#     -v "$PWD/bench/parsers/out/mineru:/out" \
#     -v evo-mineru-models:/models \
#     evo-parse-bench-mineru --threads 4 --backends mineru-pipeline-cpu
#
# Point --docs at the `_capped` directory the other image produced, so both
# runs provably parse byte-identical input.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/models \
    TORCH_HOME=/models/torch \
    MINERU_MODEL_SOURCE=huggingface \
    MINERU_DEVICE_MODE=cpu

RUN pip install --no-cache-dir torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# [pipeline] not [all]: the hybrid VLM route needs vLLM and is GPU-only, so it
# has no place in a CPU benchmark. Same version floor as modal/parse_common.py so
# this measures the backend actually in production.
# `six` is an undeclared transitive import in the pipeline backend's model
# stack. On the Modal image it arrives by accident via the CUDA extras; on a
# slim CPU base nothing pulls it in and every parse dies at import time.
RUN pip install --no-cache-dir \
    "mineru[pipeline]>=3.4.4,<3.5" \
    pypdfium2 \
    six

WORKDIR /bench
COPY normalize.py run_bench.py fetch_samples.py ./
RUN mkdir -p /bench/docs /out /models

ENTRYPOINT ["python", "run_bench.py"]
