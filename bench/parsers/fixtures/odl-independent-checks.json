    {
      "id": "bert-p6-column-continuation",
      "document": "bert",
      "page": 6,
      "text": "Given a question and a passage from Wikipedia containing the answer, the task is to predict the answer text span in the passage.",
      "requirement": "Correct sequence across left-column end and right-column beginning, no intervening footnotes."
    },
    {
      "id": "bert-p7-math-continuation",
      "document": "bert",
      "page": 7,
      "text": "For prediction, we compare the score of the no-answer span",
      "formulae": [
        "s_null = S·C + E·C",
        "s_hat_i,j = max_(j≥i) S·T_i + E·T_j",
        "s_hat_i,j > s_null + τ"
      ],
      "requirement": "Complete equations, superscript/subscript and max scope preserved; correct left-to-right column body continuation."
    },
    {
      "id": "resnet-p6-column-continuation",
      "document": "resnet",
      "page": 6,
      "text": "We have shown that parameter-free, identity shortcuts help with training.",
      "requirement": "One body sentence across column boundary; Figure 5 and caption excluded from sentence."
    },
    {
      "id": "resnet-p8-column-continuation",
      "document": "resnet",
      "page": 8,
      "text": "The testing result of this 1202-layer network is worse than that of our 110-layer network, although both have similar training error.",
      "requirement": "Correct consecutive body sequence across column boundary."
