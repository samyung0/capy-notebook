      "evidence",
      "legacy_provenance",
      "rubric_notes",
      "tags",
      "answerability",
      "family",
      "split",
      "provenance"
    ],
    "scope_source_ids_null_means": "all 29 shared corpus sources",
    "split_policy": "All five questions use split=heldout only for runner compatibility. This is a known-failure diagnostic, NOT a fresh held-out set. Report separately from the primary16development/48heldout questions.",
    "parser_policy": "Primary comparison uses final refined native ODL and full MinerU parsing. Any hybrid OCR/formula arm must be reported separately.",
    "grading": "Semantic answer correctness, all-claim source support, observed-evidence coverage, citation support, and missing-evidence behavior are separate. Literal text matching is diagnostic only.",
    "explicit_scope_policy": "Restrict both search and read_document to the listed logical source IDs mapped to arm-specific file IDs; show the permitted filenames to the agent. Gold source_ids never defines tool scope.",
    "equivalent_evidence_policy": "Accept semantically equivalent source-supported answers and citations from another permitted source when the question does not name a particular source, table or figure. The listed source_ids are expected gold evidence, not an exclusive evidence allowlist.",
    "freeze_note": "Frozen before diagnostic agent answers after independent original-PDF review confirmed all five required-answer rubrics. One unrelated supporting-table BLEU transcription was corrected before freeze; required claims were unchanged. Primary fixture remains unchanged.",
    "evaluation_kind": "diagnostic_known_failures",
    "provenance": "known parser failures from prior evaluation",
    "run_policy": "Run only after selecting and freezing the retrieval candidate. Never use these questions or outcomes for candidate tuning. Never blend these results into the primary48-question held-out score.",
    "primary_fixture_sha256": "262346659ff2c096c7a08e7b658ac8dfc7f70fe5fad258ab025ac218609be0ce",
    "selection_note": "Known parser failure families selected by root before this diagnostic was authored. No new caption or agent answer was inspected; original PDF pixels were reviewed and primary question overlap was checked.",
    "overlap_note": "CCLchildren exact model identifier is also present in primary048; the diagnostic asks a distinct Table1 minimum and grouped score lookup, and does not count identifier spelling as a novel independent test.",
    "independent_source_review": "bench/rag/reports/local/2026-09-09-odl-agentic-source/diagnostic-source-review.md"
  },
  "questions": [
    {
      "id": "odl-agentic-stress-001",
      "split": "heldout",
      "family": "diagnostic-resnet-table3",
      "language": "en",
      "question": "In Table 3 of Deep Residual Learning for Image Recognition, give the top-1 and top-5 error rates for ResNet-50, ResNet-101 and ResNet-152. State the evaluation split and crop setting used for that table.",
      "scope_source_ids": null,
      "source_ids": [
        "resnet"
      ],
      "answerability": "answerable",
      "tags": [
        "diagnostic_known_failures",
        "table",
        "row-column-association"
      ],
      "required_claims": [
        "ResNet-50: top-1 error 22.85%, top-5 error 6.71%.",
        "ResNet-101: top-1 error 21.75%, top-5 error 6.05%.",
        "ResNet-152: top-1 error 21.43%, top-5 error 5.71%.",
        "Table 3 uses ImageNet validation with 10-crop testing."
      ],
      "evidence": [
        {
          "source_id": "resnet",
          "pdf_page": 6,
          "source_cells_or_image_transcription": {
            "Table3": {
              "columns": [
                "model",
