                "width": 640,
                "height": 111,
                "srcset": "https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Mitosis_Stages.svg/1280px-Mitosis_Stages.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"
              },
