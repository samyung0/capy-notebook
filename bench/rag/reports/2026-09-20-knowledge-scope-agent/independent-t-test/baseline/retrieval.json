          "book_id": "lsj",
          "book_title": "Learning Statistics with jamovi: A Tutorial for Beginners in Statistical Analysis",
          "section_path": "Bayesian statistics › 16.4 Bayesian 𝑡-tests › 16.4.1 Independent samples 𝑡-test",
