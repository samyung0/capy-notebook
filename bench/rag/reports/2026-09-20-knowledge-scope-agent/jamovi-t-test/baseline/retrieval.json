        {
          "id": "exc_45ecdb7da7734b_244_v2",
          "book_id": "lsj",
          "book_title": "Learning Statistics with jamovi: A Tutorial for Beginners in Statistical Analysis",
          "section_path": "Comparing two means › 11.5 The independent samples 𝑡-test (Welch test)",
          "roles": [
