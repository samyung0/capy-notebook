# Collaboration sidecar. Copy to collaboration/.env for local `pnpm dev`.
# `pnpm dev` / `pnpm start` load .env via Node --env-file-if-exists when present.
# Code also falls back to the same local defaults if unset.
#
# Production/docker should set these explicitly (see deploy/docker-compose.yml).

# Browser origins allowed to open the WebSocket (comma-separated).
COLLABORATION_ALLOWED_ORIGINS=http://localhost:5173

# Must match the Go API COLLABORATION_SECRET.
COLLABORATION_SECRET=dev-collaboration-secret

# Go internal API (projection + commands).
API_URL=http://localhost:8080

DATABASE_URL=postgres://evo:evo@localhost:5432/evo?sslmode=disable
REDIS_URL=redis://localhost:6379/0

APP_ENV=development
# SENTRY_DSN=
# RELEASE_SHA=
# LOG_FORMAT=text

# Optional
# HOST=0.0.0.0
# PORT=1234
# COLLABORATION_DEBOUNCE_MS=2000
# COLLABORATION_MAX_DEBOUNCE_MS=10000
# COLLABORATION_MAX_PAYLOAD_BYTES=2097152
