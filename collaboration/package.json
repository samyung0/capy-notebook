{
  "name": "@evo-notes/collaboration",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "chaos": "tsx --env-file-if-exists=.env scripts/chaos-peers.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "4.4.0",
    "@hocuspocus/server": "4.4.0",
    "@slate-yjs/core": "1.0.2",
    "ioredis": "^5.6.1",
    "pg": "^8.22.0",
    "slate": "0.124.1",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.18.3"
  }
}
