{
  "name": "@capy-notebook/collaboration",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-markdown.mjs",
    "chaos": "tsx --env-file-if-exists=../deploy/.env scripts/chaos-peers.ts",
    "dev": "tsx watch --env-file-if-exists=../deploy/.env src/server.ts",
    "start": "node --env-file-if-exists=../deploy/.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:markdown": "node scripts/build-markdown.mjs"
  },
  "dependencies": {
    "@hocuspocus/server": "4.5.0",
    "@sentry/node": "^10.70.0",
    "@slate-yjs/core": "1.0.2",
    "ioredis": "5.6.1",
    "pg": "^8.22.0",
    "slate": "0.124.1",
    "yjs": "13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hocuspocus/provider": "3.4.4",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/basic-styles": "^53.0.0",
    "@platejs/callout": "^53.0.0",
    "@platejs/code-block": "^53.0.0",
    "@platejs/combobox": "^53.0.0",
    "@platejs/indent": "^53.0.0",
    "@platejs/layout": "^53.0.0",
    "@platejs/link": "^53.3.1",
    "@platejs/list": "^53.1.3",
    "@platejs/markdown": "^53.2.2",
    "@platejs/media": "^53.1.4",
    "@platejs/mention": "^53.0.0",
    "@platejs/table": "^53.0.9",
    "@platejs/toc": "^53.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "katex": "^0.17.0",
    "lowlight": "^3.3.0",
    "platejs": "^53.2.4",
    "react": "^19.0.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.18.3",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  }
}
