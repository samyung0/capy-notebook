# Docker stack. Copy to deploy/.env — docker-compose auto-loads it.
# DATABASE_URL, REDIS_URL and PIPELINE_URL are wired between the
# containers inside docker-compose.yml; the vars below are interpolated into it.
#
# Public hostnames (see openwiki/deployment-runbook.md §1):
#   https://abcd.com          SPA (Cloudflare Pages / static)
#   https://api.abcd.com      this compose's `server` (Go gateway)
#   wss://collab.abcd.com     this compose's `collaboration`
# Retrieval (:8001), the ingest worker, Postgres and Redis stay private.

# ── App identity ────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:5173
# Comma-separated SPA origins. Empty falls back to *. Set this once the SPA
# has a real hostname: https://abcd.com,https://www.abcd.com
CORS_ALLOWED_ORIGINS=
# Browser origins allowed to open the collab WebSocket. Defaults to APP_URL.
# Production with www: https://abcd.com,https://www.abcd.com
# COLLABORATION_ALLOWED_ORIGINS=
# Browser-reachable collab WebSocket. Local docker: ws://localhost:1234
# Production: wss://collab.abcd.com
COLLABORATION_URL=ws://localhost:1234
COLLABORATION_SECRET=
PIPELINE_SECRET=dev-pipeline-secret

# ── Auth / billing (leave AUTH_DISABLED=true for local docker without Clerk)
AUTH_DISABLED=true
DEV_USER_ID=u_1
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ── Observability. Empty Sentry DSNs disable reporting.
# Four Sentry projects in production (gateway / retrieval / worker / collab).
# For local, one DSN copied into all four is fine.
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set in CI to the git SHA so Sentry events attach to a deploy.
RELEASE_SHA=
# json outside development; override if needed.
# LOG_FORMAT=json
# LOG_LEVEL=info

# ── Rate limits (gateway). Unset uses code defaults (AI 200/hr, 3 streams).
# Forced off when APP_ENV=e2e. Do not set RATE_LIMIT_DISABLED in production.
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_AI_PER_HOUR=200
# RATE_LIMIT_CONCURRENT_STREAMS=3

# ── Modal GPU MineRU parse service (deploy modal/mineru_app.py first) ────────
# One deploy publishes both endpoints: accurate (hybrid VLM) and fast (pipeline
# OCR). Same bundle format from both; they differ in backend and cost.
MODAL_PARSE_URL=            # parseMode=accurate
MODAL_FAST_PARSE_URL=       # parseMode=fast
MODAL_PARSE_TOKEN=
MODAL_B2_ARTIFACTS=true
EVO_PARSE_METHOD=ocr

# ── Embeddings: OpenRouter (Qwen3-Embedding-4B) ─────────────────────────────
# API keys only. Model identity is a model_configs row, pinned per workspace at
# creation and never changed — there is no reindex job. EMBEDDING_DIM is the
# width the schema ships with; another width needs its own vector table.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIM=2560

# ── Text LLM: DeepSeek (keys stay in env; multipliers live on model_configs)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
EVO_QUERY_MODEL=deepseek-v4-flash

# ── Vision / image captions: Gemini (OpenAI-compatible endpoint) ────────────
# The model is a model_configs row, snapshotted onto each ingest job.
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EVO_CAPTION_CONCURRENCY=8
# EVO_CAPTION_MAX_EDGE=1280
# EVO_CAPTION_VERSION=v1      # bump to invalidate every cached caption

# ── Parse/caption artifact cache TTLs ───────────────────────────────────────
# Read by the gateway's sweeper and by the ingest worker's idle sweep, which run
# the identical statement. Give both services the same values.
# EVO_CAPTION_CACHE_TTL_DAYS=90
# EVO_PARSE_ZIP_TTL_HOURS=6

# ── Speech-to-text (Whisper). Used by retrieval's /transcribe, not the worker.
# Either WHISPER_API_KEY or OPENAI_API_KEY. Unset → empty transcripts.
WHISPER_API_KEY=
# OPENAI_API_KEY=
# WHISPER_BASE_URL=https://api.openai.com/v1

# ── Blob storage ────────────────────────────────────────────────────────────
# Backblaze B2 is required. Browsers upload directly; workers mint parser URLs.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# B2_FORCE_PATH_STYLE=false
# B2_PRESIGN_TTL=900          # raw-file presigned URL lifetime, seconds

# ── Product mail (Clerk still owns identity/authentication emails) ──────────
EMAIL_BACKEND=resend
RESEND_API_KEY=
EMAIL_FROM=Evo Notes <notifications@example.com>
EMAIL_REPLY_TO=
# Required for Resend: generate at least 32 random bytes.
EMAIL_UNSUBSCRIBE_SECRET=

# Job payload labels (informational; the parse route follows the file's
# parseMode, not these).
EVO_PARSER=mineru
EVO_ENGINE=evo

# Concurrent ingest workers. Each replica runs one job at a time, so this is
# also the number of concurrent Modal parses. Start at 1; 3 is comfortable
# against default Postgres max_connections=100 (12 connections per replica).
# WORKER_REPLICAS=1
