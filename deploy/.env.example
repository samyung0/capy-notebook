# Docker stack. Copy to deploy/.env — docker-compose auto-loads it.
# DATABASE_URL, REDIS_URL and PIPELINE_URL are wired between the
# containers inside docker-compose.yml; the vars below are interpolated into it.
#
# Public hostnames (see openwiki/deployment-runbook.md §1):
#   https://abcd.com          SPA (Cloudflare Pages / static)
#   https://api.abcd.com      this compose's `server` (Go gateway)
#   wss://collab.abcd.com     this compose's `collaboration`
#   https://ops.evonotes.com  Access-protected operator dashboard
# Retrieval (:8001), the ingest worker, Postgres and Redis stay private.

# ── App identity ────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:5173
# Comma-separated SPA origins. Empty falls back to *. Set this once the SPA
# has a real hostname: https://abcd.com,https://www.abcd.com
CORS_ALLOWED_ORIGINS=
# Browser origins allowed to open the collab WebSocket. Defaults to APP_URL.
# Production with www: https://abcd.com,https://www.abcd.com
# COLLABORATION_ALLOWED_ORIGINS=
# Browser-reachable collab WebSocket. Local docker: ws://localhost:1234
# Production: wss://collab.abcd.com
COLLABORATION_URL=ws://localhost:1234
COLLABORATION_SECRET=
PIPELINE_SECRET=dev-pipeline-secret
# Cloudflare Queue relay. Generate one shared secret with `openssl rand -hex 32`
# and set the same value as the Worker's IMPORT_RELAY_SECRET secret.
IMPORT_RELAY_ENQUEUE_URL=
IMPORT_RELAY_SECRET=
# 32-byte key (64 hex chars) used to encrypt user-supplied provider keys.
# Generate with: openssl rand -hex 32
LLM_CREDENTIALS_KEY=

# ── Auth / billing (leave AUTH_DISABLED=true for local docker without Clerk)
AUTH_DISABLED=true
DEV_USER_ID=u_1
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Public Clerk key compiled into the standalone ops frontend.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk Google extra scope is drive.file (not drive.readonly). Microsoft is
# Files.Read + offline_access. Picker SPA env (VITE_GOOGLE_PICKER_*,
# VITE_MSAL_CLIENT_ID) lives in the frontend .env, not this file.
# See openwiki/deployment-runbook.md §11.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# ── Observability. Empty Sentry DSNs disable reporting.
# Five Sentry projects in production (gateway / retrieval / worker / collab /
# ops). For local, one DSN copied into all five is fine.
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_DSN_OPS=
VITE_SENTRY_DSN_OPS=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set in CI to the git SHA so Sentry events attach to a deploy.
RELEASE_SHA=
# json outside development; override if needed.
# LOG_FORMAT=json
# LOG_LEVEL=info

# ── Rate limits (gateway). Unset uses code defaults (AI 200/hr).
# Forced off when APP_ENV=e2e. Do not set RATE_LIMIT_DISABLED in production.
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_AI_PER_HOUR=200

# ── Operator dashboard ──────────────────────────────────────────────────────
# Start with: docker compose -f deploy/docker-compose.yml --profile ops up ops
# Production must replace these local-owner URLs with the three roles granted
# in deployment-runbook.md §8 and point them at private Postgres.
OPS_DATABASE_URL=postgres://evo:evo@db:5432/evo?sslmode=disable
OPS_ADMIN_DATABASE_URL=postgres://evo:evo@db:5432/evo?sslmode=disable
# Cloudflare Access application values for https://ops.evonotes.com.
# Issuer has the form https://<team-name>.cloudflareaccess.com.
# JWKS defaults to <issuer>/cdn-cgi/access/certs when unset.
OPS_CF_ACCESS_ISSUER=
OPS_CF_ACCESS_AUDIENCE=
# OPS_CF_ACCESS_JWKS_URL=
# Auth stays fail closed even when APP_ENV is omitted or development.
OPS_ACCESS_DISABLED=false
OPS_AUTH_DISABLED=false
# Local owner DSNs or auth bypasses require all three development-only opt-ins:
# APP_ENV=development, OPS_UNSAFE_DEVELOPMENT=true, and the specific bypasses.
OPS_UNSAFE_DEVELOPMENT=false
OPS_DEV_USER_ID=u_1

# ── Parser service ───────────────────────────────────────────────────────
# Marker + RapidOCR. Production values live on the dedicated parser VM.
PARSER_URL=
PARSER_TOKEN=
PARSER_TIMEOUT=2400
EVO_PARSE_HARD_TIMEOUT=2300
PARSER_SLOT_TTL=2700
EVO_INGEST_TIMEOUT=3600
EVO_PARSE_SLOTS=8
EVO_PARSE_METHOD=selective_rapidocr
EVO_PARSE_SHARED_DIR=/var/lib/evo-parse
# Maximum LibreOffice-derived citation-preview PDF (128 MiB).
EVO_OFFICE_PREVIEW_MAX_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_BYTES=268435456
EVO_PARSE_ARTIFACT_MAX_ENTRIES=4096
EVO_PARSE_ARTIFACT_MAX_ENTRY_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_EXPANDED_BYTES=536870912
EVO_PARSE_CONTENT_MAX_BYTES=134217728
EVO_PARSE_CONTENT_MAX_BLOCKS=250000
EVO_PARSE_IMAGE_MAX_BYTES=33554432
EVO_PARSE_IMAGES_MAX_BYTES=268435456

# ── Provider keys (elitellm platformEnv names) ─────────────────────────────
# Model identity is a model_configs row (provider_slug + model_slug). Keys are
# platform-only; never put user BYOK secrets into process env.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
EMBEDDING_DIM=2560
# EVO_CAPTION_CONCURRENCY=8
# EVO_CAPTION_MAX_EDGE=1280
# EVO_CAPTION_VERSION=v2      # bump to invalidate every cached caption

# ── Parse/caption artifact cache TTLs ───────────────────────────────────────
# Caption artifacts are durable B2 cache entries. Parse sources and bundles are
# short-lived files in the shared Netcup spool.
# EVO_CAPTION_CACHE_TTL_DAYS=90
# EVO_PARSE_ZIP_TTL_HOURS=6
# EVO_PARSE_SOURCE_TTL_HOURS=2

# ── Blob storage ────────────────────────────────────────────────────────────
# Backblaze B2 is required. Browsers upload directly; workers fetch sources once.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# B2_FORCE_PATH_STYLE=false
# B2_PRESIGN_TTL=900          # raw-file presigned URL lifetime, seconds

# ── Product mail (Clerk still owns identity/authentication emails) ──────────
EMAIL_BACKEND=resend
RESEND_API_KEY=
EMAIL_FROM=Evo Notes <notifications@example.com>
EMAIL_REPLY_TO=
# Required for Resend: generate at least 32 random bytes.
EMAIL_UNSUBSCRIBE_SECRET=

# Job payload labels (informational; the parse route follows the file's
# parseMode, not these).
EVO_PARSER=marker
EVO_ENGINE=evo

# Concurrent ingest workers. Each replica runs one job at a time. The parser
# admission cap defaults to eight; extra jobs stay pending.
# Start at 1; 3 is comfortable against default Postgres max_connections=100
# (12 connections per replica).
# WORKER_REPLICAS=1
