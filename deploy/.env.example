# The single local env file. Copy to deploy/.env — docker compose auto-loads
# it, and vite.config.ts, playwright.config.ts and the collaboration sidecar
# read it too. No component keeps its own .env.
#
# For the compose stack, DATABASE_URL, REDIS_URL and PIPELINE_URL are wired
# between containers inside docker-compose.yml; the vars below are
# interpolated into it. The DATABASE_URL/REDIS_URL near the bottom are only
# for processes you run outside docker.
#
# Public hostnames (see openwiki/deployment-runbook.md §1):
#   https://abcd.com          SPA (Cloudflare Pages / static)
#   https://api.abcd.com      this compose's `server` (Go gateway)
#   wss://collab.abcd.com     this compose's `collaboration`
#   https://ops.evonotes.com  Access-protected operator dashboard
# Retrieval (:8001), the ingest worker, Postgres and Redis stay private.

# ── App identity ────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:5173
# Comma-separated SPA origins. Empty falls back to *. Set this once the SPA
# has a real hostname: https://abcd.com,https://www.abcd.com
CORS_ALLOWED_ORIGINS=
# Browser origins allowed to open the collab WebSocket. Defaults to APP_URL.
# Production with www: https://abcd.com,https://www.abcd.com
# COLLABORATION_ALLOWED_ORIGINS=
# Browser-reachable collab WebSocket. Local docker: ws://localhost:1234
# Production: wss://collab.abcd.com
COLLABORATION_URL=ws://localhost:1234
COLLABORATION_SECRET=
PIPELINE_SECRET=dev-pipeline-secret
# 32-byte key (64 hex chars) used to encrypt user-supplied provider keys.
# Generate with: openssl rand -hex 32
LLM_CREDENTIALS_KEY=

# ── Auth / billing (leave AUTH_DISABLED=true for local docker without Clerk)
AUTH_DISABLED=true
# Seeded dev users: u_1 (free plan), u_2 (pro plan, 30 MB uploads).
DEV_USER_ID=u_1
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Public Clerk key compiled into the SPA and the standalone ops frontend.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk Google extra scope is drive.file (not drive.readonly). Microsoft is
# Files.Read + offline_access. Picker SPA env (VITE_GOOGLE_PICKER_*,
# VITE_MSAL_CLIENT_ID) is in the frontend section at the bottom of this file.
# See openwiki/deployment-runbook.md §11.
# Local billing uses the Stable Studio Dev sandbox, never the UAT one: one
# environment fans every event out to every endpoint registered in it. Get the
# webhook secret from `stripe listen --forward-to
# localhost:8080/webhooks/stripe`; no tunnel and no registered endpoint.
# Blank keeps billing disabled. See openwiki/deployment-runbook.md §12.4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── Observability. Empty Sentry DSNs disable reporting.
# Five Sentry projects in production (gateway / retrieval / worker / collab /
# ops). For local, one DSN copied into all five is fine.
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_DSN_OPS=
VITE_SENTRY_DSN_OPS=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Set in CI to the git SHA so Sentry events attach to a deploy.
RELEASE_SHA=
# json outside development; override if needed.
# LOG_FORMAT=json
# LOG_LEVEL=info

# ── Rate limits (gateway). Unset uses code defaults (AI 200/hr).
# Forced off when APP_ENV=e2e. Do not set RATE_LIMIT_DISABLED in production.
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_AI_PER_HOUR=200

# ── Operator dashboard ──────────────────────────────────────────────────────
# Start with: docker compose -f deploy/docker-compose.yml --profile ops up ops
# Production must replace these local-owner URLs with the three roles granted
# in deployment-runbook.md §8 and point them at private Postgres.
OPS_DATABASE_URL=postgres://evo:evo@db:5432/evo?sslmode=disable
OPS_ADMIN_DATABASE_URL=postgres://evo:evo@db:5432/evo?sslmode=disable
# Must equal EVO_INGEST_ENVIRONMENT on the workers writing to OPS_DATABASE_URL.
# The ingest pages filter every attempt and host sample on this value, so a
# mismatch renders an empty dashboard with no error. Local workers write `local`.
OPS_INGEST_PRIMARY_ENVIRONMENT=local
# Optional read-role DSNs add a tab per environment. Only uat and local have a
# slot, and the one matching the primary above is rejected as a duplicate, so
# this stack can add UAT only.
# OPS_INGEST_UAT_DATABASE_URL=postgres://evo_ops:<password>@<uat-db>/evo?sslmode=require
# Cloudflare Access application values for https://ops.evonotes.com.
# Issuer has the form https://<team-name>.cloudflareaccess.com.
# JWKS defaults to <issuer>/cdn-cgi/access/certs when unset.
OPS_CF_ACCESS_ISSUER=
OPS_CF_ACCESS_AUDIENCE=
# OPS_CF_ACCESS_JWKS_URL=
# Auth stays fail closed even when APP_ENV is omitted or development.
OPS_ACCESS_DISABLED=false
OPS_AUTH_DISABLED=false
# Local owner DSNs or auth bypasses require all three development-only opt-ins:
# APP_ENV=development, OPS_UNSAFE_DEVELOPMENT=true, and the specific bypasses.
OPS_UNSAFE_DEVELOPMENT=false
OPS_DEV_USER_ID=u_1

# ── Parser service ───────────────────────────────────────────────────────
# MinerU pipeline. Production values live on the dedicated ingest host.
PARSER_URL=
PARSER_TOKEN=
PARSER_TIMEOUT=2400
EVO_PARSE_SLICE_TIMEOUT=600
PARSER_SLOT_TTL=2700
EVO_PARSE_JOB_TIMEOUT=3600
EVO_INGEST_TIMEOUT=1200
EVO_PARSE_SLOTS=4
EVO_PARSE_METHOD=auto
EVO_PARSE_SHARED_DIR=/var/lib/evo-parse
# Maximum LibreOffice-derived citation-preview PDF (128 MiB).
EVO_OFFICE_PREVIEW_MAX_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_BYTES=268435456
EVO_PARSE_ARTIFACT_MAX_ENTRIES=4096
EVO_PARSE_ARTIFACT_MAX_ENTRY_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_EXPANDED_BYTES=536870912
EVO_PARSE_CONTENT_MAX_BYTES=134217728
EVO_PARSE_CONTENT_MAX_BLOCKS=250000
EVO_PARSE_IMAGE_MAX_BYTES=33554432
EVO_PARSE_IMAGES_MAX_BYTES=268435456

# ── Provider keys (elitellm platformEnv names) ─────────────────────────────
# Model identity is a model_configs row (provider_slug + model_slug). Keys are
# platform-only; never put user BYOK secrets into process env.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# EVO_ELEVENLABS_SYNC_TIMEOUT_S=43200
EMBEDDING_DIM=2560
# EVO_CAPTION_CONCURRENCY=8
# EVO_CAPTION_MAX_EDGE=1280
# EVO_CAPTION_VERSION=v2      # bump to invalidate every cached caption

# ── Parse/caption artifact cache TTLs ───────────────────────────────────────
# Caption artifacts are durable B2 cache entries. Parse sources and bundles are
# short-lived files in the shared Netcup spool.
# EVO_CAPTION_CACHE_TTL_DAYS=90
# EVO_PARSE_ZIP_TTL_HOURS=6
# EVO_PARSE_SOURCE_TTL_HOURS=2

# ── Blob storage ────────────────────────────────────────────────────────────
# Backblaze B2 is required. Browsers upload directly; workers fetch sources once.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# B2_FORCE_PATH_STYLE=false
# B2_PRESIGN_TTL=900          # raw-file presigned URL lifetime, seconds

# ── Product mail (Clerk still owns identity/authentication emails) ──────────
# Local stays on the log backend. newEmailSender refuses an empty
# RESEND_API_KEY when EMAIL_BACKEND=resend, so shipping `resend` here means a
# fresh local gateway will not start. UAT and production set `resend` with a
# domain-scoped key; see openwiki/deployment-runbook.md §12.5.
EMAIL_BACKEND=log
RESEND_API_KEY=
EMAIL_FROM=Evo Notes <notifications@example.com>
EMAIL_REPLY_TO=
# Required for Resend: generate at least 32 random bytes.
EMAIL_UNSUBSCRIBE_SECRET=

# Job payload labels (informational; the parse route follows the file's
# parseMode, not these).
EVO_PARSER=mineru
EVO_ENGINE=evo

# Concurrent ingest workers. Each replica runs one job at a time. The parser
# admission cap defaults to four; extra jobs stay pending.
# Start at 1; 3 is comfortable against default Postgres max_connections=100
# (12 connections per replica).
# WORKER_REPLICAS=1

# ── Frontend (Vite SPA) ─────────────────────────────────────────────────────
# vite.config.ts reads this file (envDir: deploy). Only VITE_-prefixed vars
# reach the browser bundle; everything above stays server-side.
#
# MSW mocks are ON by default in development. false hits the real Go gateway
# with Clerk auth. Vite proxies /api -> VITE_API_URL.
# Production builds call same-origin /api (src/api/client.ts): VITE_API_URL is
# the dev proxy target only and is not baked into the bundle.
VITE_USE_MSW=true
VITE_PORT=5173
VITE_API_URL=http://localhost:8080
# Hostname `pnpm dev:tunnel` publishes the dev server on. Clerk production
# instances (UAT/prod keys) refuse to authenticate on localhost, so a dev SPA
# talking to a deployed gateway needs a real origin. It must sit one label
# under that Clerk instance's primary domain, which is where the free session
# sharing applies; the zone's ACM pack covers the extra depth. Only
# COLLABORATION_ALLOWED_ORIGINS needs the exact origin (the bucket rule uses a
# wildcard). Safe to leave set: plain `pnpm dev` ignores it, `pnpm dev:public`
# serves through it.
# VITE_DEV_HOST=dev-<name>.uat.capynotebook.com

# Google Picker (same GCP project as the Clerk Google OAuth client).
# API key + Cloud project number. Missing either fails the picker closed.
# VITE_GOOGLE_PICKER_API_KEY=
# VITE_GOOGLE_PICKER_APP_ID=

# OneDrive File Picker v8 (Entra SPA public client, not the Clerk Microsoft
# app). Redirect URI is {SPA origin}/msal-redirect.html. Runbook §11.
# VITE_MSAL_CLIENT_ID=
# VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>

# Direct B2 upload instead of proxying bytes through the gateway.
VITE_DIRECT_B2_UPLOAD=true

# The SPA DSN is public — use a browser-only Sentry project, never the gateway
# DSN. PostHog authorized URLs must be the production SPA origin only.
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_APP_ENV=development
# VITE_RELEASE_SHA=

# Feature flags (build-time). Defaults are off.
# VITE_FEATURE_EXPLORE=false
# VITE_FEATURE_THINKING=false
# VITE_FEATURE_EDITOR_AI=false
# VITE_FEATURE_SCHEDULE=false
# VITE_FEATURE_TASKS=false
VITE_LOAD_TEST_SEED=false

# Optional separate origin for llm-runtime.html. Leave empty: the app embeds a
# same-origin iframe isolated by Document-Isolation-Policy (Chrome 137+).
# VITE_LLM_RUNTIME_ORIGIN=
# Required in production: serve office-runtime.html from a cookie-less origin.
# VITE_OFFICE_RUNTIME_ORIGIN=
# VITE_APP_URL=https://abcd.com

# ── Services run outside docker ─────────────────────────────────────────────
# The containers get these from docker-compose.yml. Set them only when you run
# a binary directly (go run ./cmd/api, uv run the worker, pnpm dev in
# collaboration). Nothing auto-loads this file for the Go binary — export it:
#   set -a; . deploy/.env; set +a
ADDR=:8080
# Local/docker: true (the API applies numbered files, then the demo seed).
# Production: false — run cmd/migrate as an explicit deploy step.
MIGRATE=true
PIPELINE_URL=http://localhost:8001
COLLABORATION_INTERNAL_URL=http://localhost:1234
# Retrieval's callback into the gateway (generate_material). Unset and the
# chat agent is not offered the tool at all.
GATEWAY_URL=http://localhost:8080
# Single-service Sentry DSN for a bare run; the containers use SENTRY_DSN_*.
# SENTRY_DSN=

# ── Retrieval / worker tuning (pipeline) ────────────────────────────────────
# Model identity is never an env var: every surface resolves an exact
# (provider_slug, model_slug, version) pin from model_configs and fails rather
# than falling back. The provider keys above are credentials only.
EVO_POLL_INTERVAL=2.0
# Interactive browser requests fail promptly; background ingest keeps a wider
# provider window and uses the job's three-attempt retry budget.
# EVO_INTERACTIVE_PROVIDER_TIMEOUT_S=25
# EVO_INGEST_PROVIDER_TIMEOUT_S=120
EVO_PARSE_COORDINATOR_CONCURRENCY=4
# Shared local/UAT queue consumers set this to one mounted directory. Leave it
# unset in production, where replica counts and parser admission own capacity.
# EVO_SHARED_CAPACITY_LOCK_DIR=/var/lib/evo-parse/capacity
# Chunk sizes are estimated tokens (~4 Latin chars or 1 CJK char). Blocks are
# never split below chunk_tokens, so a table or long paragraph stays whole.
# EVO_CHUNK_TOKENS=400
# EVO_CHUNK_OVERLAP_TOKENS=50
# EVO_CHUNK_MIN_TOKENS=40
# EVO_EMBEDDING_BATCH=64
# EVO_SEARCH_CANDIDATES=40           # per-branch candidates before rank fusion
# EVO_SEARCH_TOP_K=5                 # passages handed to the model
# EVO_SEARCH_PER_FILE_CAP=4          # stops one document flooding a result set
# EVO_AGENT_MAX_STEPS=12             # tool-calling rounds per chat turn
# EVO_LLM_INPUT_BUDGET_TOKENS=50000  # pre-model context gathering budget
# EVO_CAPTION_MAX_PER_FILE=0         # safety valve for one file; 0 = off
# EVO_IMAGE_MAX_PIXELS=100000000     # decoded pixels, not compressed bytes
# EVO_ELEVENLABS_TRANSCRIPT_VERSION=scribe-v2-1
# EVO_ELEVENLABS_CONCURRENCY_UNITS=12
# EVO_AUDIO_MAX_DURATION_SECONDS=36000
# EVO_TABULAR_TEXT_VERSION=v1

# ── Collaboration sidecar run outside docker (pnpm --filter collaboration dev)
# The container gets these from docker-compose.yml instead. Code falls back to
# the same local defaults when unset.
COLLABORATION_ALLOWED_ORIGINS=http://localhost:5173
# Go internal API (projection + commands).
API_URL=http://localhost:8080
DATABASE_URL=postgres://evo:evo@localhost:5432/evo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# HOST=0.0.0.0
# PORT=1234
# COLLABORATION_DEBOUNCE_MS=2000
# COLLABORATION_MAX_DEBOUNCE_MS=10000
# COLLABORATION_MAX_PAYLOAD_BYTES=2097152

# ── Playwright E2E ──────────────────────────────────────────────────────────
# playwright.config.ts reads this file, but never overrides a real environment
# variable. Ports are random per run unless pinned here; pin them only when
# reusing a stack across runs.
# E2E_AUTH_SECRET=e2e-test-secret
# E2E_API_URL=http://localhost:18080
# E2E_BASE_URL=http://127.0.0.1:5174
# E2E_COLLABORATION_PORT=11234
# Reuse an already-running compose stack / skip the teardown volume wipe.
# E2E_SKIP_COMPOSE=true
# E2E_KEEP_STACK=true
