# Docker stack. Copy to deploy/.env — docker-compose auto-loads it.
# DATABASE_URL, REDIS_URL and PIPELINE_URL are wired between the
# containers inside docker-compose.yml; the vars below are interpolated into it.

# ── Modal GPU MineRU parse service (deploy modal/mineru_app.py first) ────────
MODAL_PARSE_URL=
MODAL_PARSE_TOKEN=
MODAL_B2_ARTIFACTS=true
EVO_PARSE_METHOD=auto

# ── MinerU lite transfer relay (deploy cloudflare/mineru-relay) ─────────────
MINERU_RELAY_URL=
MINERU_RELAY_TOKEN=
MINERU_RELAY_TIMEOUT=180

# ── Embeddings: OpenRouter (Qwen3-Embedding-4B) ─────────────────────────────
# EMBEDDING_DIM is permanent for the vector store — changing it requires
# re-ingesting every file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EVO_MODEL_EMBEDDING=qwen/qwen3-embedding-4b
EMBEDDING_DIM=2560

# ── Text LLM: DeepSeek (flash for ingest, pro/flash for query) ──────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
EVO_MODEL_EXTRACTION=deepseek-v4-pro
EVO_QUERY_MODEL=deepseek-v4-pro
EVO_QUERY_MODEL_ALT=deepseek-v4-flash

# ── Vision / image captions: Gemini (OpenAI-compatible endpoint) ────────────
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVO_MODEL_IMAGE_CAPTION=gemini-3.1-flash-lite-preview

# ── Blob storage ────────────────────────────────────────────────────────────
# Backblaze B2 is required. Browsers upload directly; workers mint parser URLs.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
# B2_FORCE_PATH_STYLE=false
# B2_PRESIGN_TTL=900          # raw-file presigned URL lifetime, seconds

# ── Misc ────────────────────────────────────────────────────────────────────
EVO_LIGHTRAG_CACHE_SIZE=16
# Product mail is separate from Clerk identity mail.
EMAIL_BACKEND=resend
RESEND_API_KEY=
EMAIL_FROM=Evo Notes <notifications@example.com>
EMAIL_REPLY_TO=
# Required for Resend: generate at least 32 random bytes.
EMAIL_UNSUBSCRIBE_SECRET=
# Shared by Go and the Hocuspocus sidecar. Use a long random value outside dev.
COLLABORATION_SECRET=
# Public browser-reachable WebSocket origin.
COLLABORATION_URL=ws://localhost:1234
# Job payload labels (informational; worker always uses LightRAG + Modal MineRU).
EVO_PARSER=mineru
EVO_ENGINE=lightrag
