# Production deployment inputs. Copy to ignored deploy/.env.prod, mode 0600.
# GitHub is the deployed source of truth. Validate and upload using env:check
# and env:push; every deployment applies GitHub configuration to its targets.
# No shell evaluation or ${...} interpolation is supported by env:push.
# Generate distinct secrets for every environment.

# ── Required on first deploy ────────────────────────────────────────────────
POSTGRES_PASSWORD=
# GitHub env sync derives this from POSTGRES_PASSWORD, with URL-encoded
# credentials. For manual Compose, fill the equivalent container address.
DATABASE_URL=postgres://capy:replace-me@db:5432/capy?sslmode=disable
APP_URL=https://abcd.com
CORS_ALLOWED_ORIGINS=https://abcd.com,https://www.abcd.com
COLLABORATION_URL=wss://collab.abcd.com
COLLABORATION_ALLOWED_ORIGINS=https://abcd.com
COLLABORATION_SECRET=
PIPELINE_SECRET=
LLM_CREDENTIALS_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ── Provider keys (elitellm platformEnv names for hops you actually run) ──
# DeepInfra carries the seeded Qwen embedding and ZAI GLM exceptions.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# CAPY_ELEVENLABS_SYNC_TIMEOUT_S=43200
EMBEDDING_DIM=2560
# Per-model outbound caps, provider:model=total/interactive_reserve. Required:
# retrieval and the ingest workers refuse to start without it.
CAPY_MODEL_CONCURRENCY=deepinfra:zai-org/GLM-5.3-Flash=200/120,deepinfra:Qwen/Qwen3-Embedding-4B=200/80

# ── Mail / billing ──────────────────────────────────────────────────────────
EMAIL_BACKEND=resend
RESEND_API_KEY=
EMAIL_FROM=Capy Notebook <notifications@example.com>
EMAIL_REPLY_TO=support@stablestudio.org
# Needs >=32 chars and >=3 character classes, so plain hex is rejected and the
# gateway exits at startup. Use: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
EMAIL_UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── Private parser network ──────────────────────────────────────────────────
# Address on the app host's WireGuard interface. Postgres and Redis bind here.
# Leave unset before WireGuard exists; Compose then binds them to loopback.
CAPY_PRIVATE_BIND_ADDRESS=10.77.0.1

# Parser and queue settings below are uploaded with the app configuration.
# CI derives the ingest database/Redis/gateway addresses from this private IP.

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_DSN_OPS=
VITE_SENTRY_DSN_OPS=
SENTRY_TRACES_SAMPLE_RATE=0.1
# The Sentry environment tag. Leave empty here and set `uat` in the UAT
# resource, whose APP_ENV stays `production` to exercise production checks.
SENTRY_ENVIRONMENT=
# Coolify Git deploys inject SOURCE_COMMIT; set this only for a CLI deploy.
RELEASE_SHA=


# ── Independent Ops deployment, after §8 grants and Access setup ──────────
# Enable Connect to Predefined Network on both Coolify applications.
# Replace <main-db-host> with its full database container hostname, not `db`.
# OPS_DATABASE_URL=postgres://capy_ops:<password>@<main-db-host>:5432/capy?sslmode=disable
# OPS_ADMIN_DATABASE_URL=postgres://capy_ops_admin:<password>@<main-db-host>:5432/capy?sslmode=disable
# Match CAPY_INGEST_ENVIRONMENT on the workers writing to OPS_DATABASE_URL:
# Use the selected deployment environment: `uat` or `production`.
# OPS_INGEST_PRIMARY_ENVIRONMENT=production
# OPS_INGEST_UAT_DATABASE_URL=postgres://capy_ops:<password>@<uat-db>/capy?sslmode=require
# OPS_INGEST_LOCAL_DATABASE_URL=postgres://capy_ops:<password>@<local-db>/capy?sslmode=require
# OPS_CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# OPS_CF_ACCESS_AUDIENCE=
# CLERK_PUBLISHABLE_KEY is shared with the browser build and ops below.
# Run Deploy Ops after configuring its separate Coolify application.

# ── Optional ────────────────────────────────────────────────────────────────
# WORKER_REPLICAS=1
# RATE_LIMIT_AI_PER_HOUR=200

# GitHub deployment connection and browser build inputs.
COOLIFY_API_URL=
COOLIFY_RESOURCE_UUID=
COOLIFY_OPS_RESOURCE_UUID=
COOLIFY_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
DEPLOYMENT_APP_URL=https://abcd.com
DEPLOYMENT_API_URL=https://api.abcd.com
DEPLOYMENT_COLLAB_URL=wss://collab.abcd.com
# Optional ops edge probe URL.
DEPLOYMENT_OPS_URL=https://ops.capynotebook.com
CLERK_PUBLISHABLE_KEY=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=
VITE_MSAL_CLIENT_ID=
VITE_OFFICE_RUNTIME_ORIGIN=https://office.abcd.com
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=capy-web
SENTRY_URL=https://de.sentry.io/

# Ingest SSH identity. Double-quoted \n escapes allow a multiline private key.
INGEST_HOST=159.195.61.195
INGEST_HOST_USER=capy-ingest
INGEST_HOST_SSH_PORT=22
INGEST_HOST_SSH_PRIVATE_KEY=
INGEST_HOST_KNOWN_HOSTS=
PARSER_BIND_ADDRESS=10.77.0.2
PARSER_TOKEN=
CAPY_INGEST_HOST_ID=netcup-ingest-prod
# Optional parser/worker tuning keys are listed in ingest-host.env.example.

# Exact HTTPS origins permitted to embed the isolated Office runtime (comma-separated).
OFFICE_ALLOWED_PARENT_ORIGINS=
