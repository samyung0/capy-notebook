# Production env for deploy/docker-compose.prod.yml.
# Copy to deploy/.env.prod for a manual compose up, or paste into Coolify
# Environment Variables (mark passwords/keys as secrets).
#
# Generate secrets with: openssl rand -hex 32
# Postgres password must not contain @ : / ? # or the DATABASE_URL breaks.

# ── Required on first deploy ────────────────────────────────────────────────
POSTGRES_PASSWORD=
APP_URL=https://abcd.com
CORS_ALLOWED_ORIGINS=https://abcd.com,https://www.abcd.com
COLLABORATION_URL=wss://collab.abcd.com
COLLABORATION_ALLOWED_ORIGINS=https://abcd.com
COLLABORATION_SECRET=
PIPELINE_SECRET=
LLM_CREDENTIALS_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ── Provider keys (elitellm platformEnv names for hops you actually run) ──
# DeepInfra carries the seeded Qwen embedding and ZAI GLM exceptions.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# EVO_ELEVENLABS_SYNC_TIMEOUT_S=43200
EMBEDDING_DIM=2560

# ── Mail / billing ──────────────────────────────────────────────────────────
EMAIL_BACKEND=resend
RESEND_API_KEY=
EMAIL_FROM=Evo Notes <notifications@example.com>
EMAIL_REPLY_TO=
# Needs >=32 chars and >=3 character classes, so plain hex is rejected and the
# gateway exits at startup. Use: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
EMAIL_UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── Private parser network ──────────────────────────────────────────────────
# Address on the app host's WireGuard interface. Postgres and Redis bind here.
# Leave unset before WireGuard exists; Compose then binds them to loopback.
EVO_PRIVATE_BIND_ADDRESS=10.77.0.1

# The production ingest worker and its parse settings live in
# deploy/ingest-host.env on the dedicated ingest host.

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_DSN_OPS=
VITE_SENTRY_DSN_OPS=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Coolify Git deploys inject SOURCE_COMMIT; set this only for a CLI deploy.
RELEASE_SHA=


# ── After §8 grants: add these, then set COMPOSE_PROFILES=ops ───────────────
# Host is `db` while Postgres is this compose service.
# OPS_DATABASE_URL=postgres://evo_ops:<password>@db:5432/evo?sslmode=disable
# OPS_ADMIN_DATABASE_URL=postgres://evo_ops_admin:<password>@db:5432/evo?sslmode=disable
# Match EVO_INGEST_ENVIRONMENT on the workers writing to OPS_DATABASE_URL:
# `production` here, `uat` in the UAT resource that reuses this file.
# OPS_INGEST_PRIMARY_ENVIRONMENT=production
# OPS_INGEST_UAT_DATABASE_URL=postgres://evo_ops:<password>@<uat-db>/evo?sslmode=require
# OPS_INGEST_LOCAL_DATABASE_URL=postgres://evo_ops:<password>@<local-db>/evo?sslmode=require
# OPS_CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# OPS_CF_ACCESS_AUDIENCE=
# VITE_CLERK_PUBLISHABLE_KEY=
# COMPOSE_PROFILES=ops

# ── Optional ────────────────────────────────────────────────────────────────
# WORKER_REPLICAS=1
# RATE_LIMIT_AI_PER_HOUR=200
