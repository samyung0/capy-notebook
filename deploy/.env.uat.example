# Local copy for scripts/review/*. Never commit review/.env.uat.
UAT_TARGET_AUTHORIZED=false
UAT_APP_URL=https://uat.example.com
UAT_API_URL=https://api.uat.example.com
UAT_COLLAB_URL=wss://collab.uat.example.com
UAT_OPS_URL=https://ops.uat.example.com
UAT_ALLOWED_HOSTS=uat.example.com,api.uat.example.com,collab.uat.example.com,ops.uat.example.com

# Deployment-provider values used by the guided setup and GitHub environment.
COOLIFY_API_URL=https://coolify.example.com/api/v1
COOLIFY_RESOURCE_UUID=
COOLIFY_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_BRANCH=main
# Cloudflare Tunnel that fronts the UAT origin; cloudflared runs on the VM.
CLOUDFLARE_TUNNEL_ID=

# Clerk UAT application. The secret is used only by authenticated Playwright.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
UAT_OWNER_EMAIL=
UAT_EDITOR_EMAIL=
UAT_COMMENTER_EMAIL=
UAT_VIEWER_EMAIL=
UAT_OTHER_EMAIL=
UAT_SUSPENDED_EMAIL=
UAT_OVER_QUOTA_EMAIL=
UAT_FIXTURE_WORKSPACE_ID=
UAT_FIXTURE_MATERIAL_ID=

# Strix 1.5.3 runs locally only (scripts/review/strix-scan.sh) and never in
# GitHub Actions. STRIX_UAT_AUTH_INSTRUCTIONS is optional synthetic login
# guidance; it is written only to a mode-0600 temp file for the scan.
STRIX_LLM=openai/gpt-5.4
LLM_API_KEY=
STRIX_UAT_AUTH_INSTRUCTIONS=
STRIX_MAX_BUDGET=40

# Stripe UAT sandbox deployment values. CI does not need these secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# UAT deployment secrets, mirrored from the Coolify uat resource. Coolify hides
# a variable marked shown-once from both its UI and its API, so these live here
# too: the ingest host queue env and OPS_INGEST_UAT_DATABASE_URL need the
# Postgres password in cleartext. Never commit review/.env.uat.
# POSTGRES_PASSWORD must avoid @ : / ? # or DATABASE_URL breaks: use
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# WireGuard address Postgres, Redis and the gateway's :8080 publish on, so the
# ingest host's import worker can reach GATEWAY_URL.
EVO_PRIVATE_BIND_ADDRESS=10.77.0.3
# Exactly 32 bytes as hex or base64: openssl rand -hex 32
LLM_CREDENTIALS_KEY=
# EMAIL_UNSUBSCRIBE_SECRET needs >=32 chars and >=3 character classes, so plain
# hex is rejected. For these four use:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
COLLABORATION_SECRET=
PIPELINE_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=

# ── Sentry (EU region). One capy-backend DSN across the four services; the
# browser gets capy-web. capy-ops is added when the ops profile is enabled.
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_DSN_OPS=
VITE_SENTRY_DSN_OPS=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=uat
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload; keep the token out of deploy/.env so local builds skip it.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=capy-web
SENTRY_URL=https://de.sentry.io/
