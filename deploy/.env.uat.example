# UAT deployment inputs. Copy to ignored deploy/.env.uat, mode 0600.
# GitHub is the deployed source of truth. Validate and upload using env:check
# and env:push; every deployment applies GitHub configuration to its targets.
# No shell evaluation or ${...} interpolation is supported by env:push.
# Generate distinct secrets for every environment.

# ── Required on first deploy ────────────────────────────────────────────────
POSTGRES_PASSWORD=
# GitHub env sync derives this from POSTGRES_PASSWORD, with URL-encoded
# credentials. For manual Compose, fill the equivalent container address.
DATABASE_URL=postgres://capy:replace-me@db:5432/capy?sslmode=disable
APP_URL=https://uat.capynotebook.com
# Keep the old app origins until existing tabs/drafts are recovered; see runbook §1.0.2.
CORS_ALLOWED_ORIGINS=https://uat.capynotebook.com
COLLABORATION_URL=wss://uat-collab.capynotebook.com
COLLABORATION_ALLOWED_ORIGINS=https://uat.capynotebook.com,https://local.uat.capynotebook.com
COLLABORATION_SECRET=
# The in-place Yjs collection at each fold (openwiki backend-storage-quota.md
# "Yjs storage growth"). Leave it empty: the server refuses true outside tests
# until the collection's inputs exist.
COLLABORATION_GC_COLLECT=
# Signs /w/ summary links; the site Worker receives the same value. openssl rand -hex 32
SHARE_LINK_SECRET=
# The Turnstile widget's secret, which verifies signed-out answer checks
# (runbook: Turnstile widget).
TURNSTILE_SECRET_KEY=
# typesafe.ai Jev: grades open quiz parts and checks authors' open questions.
JEV_TYPESAFE_API_KEY=
# UAT only: the refusal journey holds its own file's publication while the
# file's name contains [hold-publication]. The renderer refuses it in production.
COLLABORATION_UAT_PUBLICATION_HOLD=true
# UAT only: the chat journey's [uat-scripted-tools] messages run their scripted
# tool calls instead of the model. Refused in production by the renderer, and by
# retrieval itself unless SENTRY_ENVIRONMENT=uat.
RETRIEVAL_UAT_SCRIPTED_TOOLS=true
# UAT only, on the UAT ingest workers (uat.queue.env): file-name markers fail a
# file's summary ([uat-fail-summary]) or VLM page reads ([uat-fail-pages]), or
# script its page reads ([uat-scripted-vlm]), with no provider call. Refused in
# production by the renderer, and by the pipeline unless SENTRY_ENVIRONMENT=uat.
CAPY_UAT_FAIL_PARTS=
INGEST_UAT_SCRIPTED_VLM=
PIPELINE_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ── Provider keys (elitellm platformEnv names for hops you actually run) ──
# DeepInfra carries the seeded Qwen embedding; OpenRouter serves the
# zai/glm-5.3-flash chat pin and the DeepSeek ingest and captioning pins.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
# Alibaba Model Studio (Singapore workspace) transcribes uploaded audio in the
# ingest worker and chat voice input in the API: the key, and the workspace's
# .../compatible-mode/v1 URL.
ALIBABA_MODELSTUDIO_KEY=
ALIBABA_MODELSTUDIO_URL=
EMBEDDING_DIM=2560

# ── Knowledge library (curate mode) ─────────────────────────────────────────
# Reader connection to the shared library database on the ingest host. Unset
# leaves the library tools unavailable and curate turns refused.
LIBRARY_DATABASE_URL=
# Dedicated private bucket holding the library's book PDFs, all five or
# none. Unset leaves capture_knowledge_page unavailable.
KNOWLEDGE_BASE_B2_ENDPOINT=
KNOWLEDGE_BASE_B2_REGION=
KNOWLEDGE_BASE_B2_BUCKET=
KNOWLEDGE_BASE_B2_KEY_ID=
KNOWLEDGE_BASE_B2_APP_KEY=

# ── Question bank ───────────────────────────────────────────────────────────
# Reader connection to the shared bank database on the ingest host, as
# capy_library_reader over WireGuard:
# postgres://capy_library_reader:<pw>@10.77.0.2:5433/bank?sslmode=disable
# Unset leaves the bank page and the agent's bank tools unavailable.
BANK_DATABASE_URL=
# Public base of the bank's figures; the SPA build gets it as
# VITE_BANK_ASSETS_URL (scripts/env/config.py).
BANK_ASSETS_URL=

# ── Mail / billing ──────────────────────────────────────────────────────────
EMAIL_BACKEND=cloudflare
# Account API token with Email Sending permission; CLOUDFLARE_ACCOUNT_ID is below.
CLOUDFLARE_EMAIL_TOKEN=
EMAIL_FROM="Capy Notebook <notifications@example.com>"
EMAIL_REPLY_TO=support@capynotebook.com
# Needs >=32 chars and >=3 character classes, so plain hex is rejected and the
# gateway exits at startup. Use: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
EMAIL_UNSUBSCRIBE_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ── Private parser network ──────────────────────────────────────────────────
# Address on the app host's WireGuard interface. Postgres, Redis and the
# gateway publish here for the ingest host; required.
CAPY_PRIVATE_BIND_ADDRESS=10.77.0.3

# Parser and queue settings below are uploaded with the app configuration.
# CI derives the ingest database/Redis/gateway addresses from this private IP.

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN_GATEWAY=
SENTRY_DSN_RETRIEVAL=
SENTRY_DSN_WORKER=
SENTRY_DSN_COLLABORATION=
SENTRY_DSN_OPS=
VITE_SENTRY_DSN_OPS=
SENTRY_TRACES_SAMPLE_RATE=0.1
# The Sentry environment tag. Leave empty here and set `uat` in the UAT
# resource, whose APP_ENV stays `production` to exercise production checks.
SENTRY_ENVIRONMENT=uat


# ── Independent Ops deployment, after §8 grants and Access setup ──────────
# Ops joins the main stack's `capy` network, where the database is `db`.
# OPS_DATABASE_URL=postgres://capy_ops:<password>@db:5432/capy?sslmode=disable
# OPS_ADMIN_DATABASE_URL=postgres://capy_ops_admin:<password>@db:5432/capy?sslmode=disable
# Same reader URL as LIBRARY_DATABASE_URL above; required for the ops deploy.
OPS_LIBRARY_DATABASE_URL=
# Match CAPY_INGEST_ENVIRONMENT on the workers writing to OPS_DATABASE_URL:
# Use the selected deployment environment: `uat` or `production`.
OPS_INGEST_PRIMARY_ENVIRONMENT=uat
# OPS_INGEST_UAT_DATABASE_URL=postgres://capy_ops:<password>@<uat-db>/capy?sslmode=require
# OPS_INGEST_LOCAL_DATABASE_URL=postgres://capy_ops:<password>@<local-db>/capy?sslmode=require
# OPS_CF_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# OPS_CF_ACCESS_AUDIENCE=
# Derived from the issuer when unset.
# OPS_CF_ACCESS_JWKS_URL=
# CLERK_PUBLISHABLE_KEY (below) and VITE_SENTRY_DSN_OPS are built into the
# Ops image by Deploy Ops's image job.

# ── Optional ────────────────────────────────────────────────────────────────
# WORKER_REPLICAS=1
# RATE_LIMIT_AI_PER_HOUR=200
# Job payload label; the parse route follows the file's parseMode, not this.
# CAPY_PARSER=opendataloader
# Durable caption cache TTL; the gateway and the ingest workers must match.
# CAPY_CAPTION_CACHE_TTL_DAYS=90
# First-event bound, silence allowed once a stream has started, and the
# whole-stream backstop for one interactive call.
# CAPY_INTERACTIVE_PROVIDER_TIMEOUT_S=15
# CAPY_INTERACTIVE_STREAM_IDLE_S=120
# CAPY_INTERACTIVE_STREAM_MAX_S=600
# B2_FORCE_PATH_STYLE=false
# B2_PRESIGN_TTL=900          # upload PUT lifetime, seconds; must cover a slow full-size upload
# B2_LINK_TTL=300             # read link lifetime, seconds

# GitHub deployment connection and browser build inputs.
# The deploy jobs reach the app host by SSH through Cloudflare Access only
# (deployment runbook §1.1): its Access SSH hostname, that hostname's
# known_hosts line(s), the deploy key (double-quoted, newlines as \n) and the
# Access service token allowed by the hostname's Access application.
APP_HOST_SSH_HOSTNAME=
APP_HOST_KNOWN_HOSTS=
APP_HOST_SSH_PRIVATE_KEY=
APP_HOST_ACCESS_CLIENT_ID=
APP_HOST_ACCESS_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# One Pages project serves the interactive block frame to both environments.
EMBED_PAGES_PROJECT=capy-embed
DEPLOYMENT_APP_URL=https://uat.capynotebook.com
DEPLOYMENT_API_URL=https://uat-api.capynotebook.com
DEPLOYMENT_COLLAB_URL=wss://uat-collab.capynotebook.com
DEPLOYMENT_OPS_URL=https://uat-ops.capynotebook.com
CLERK_PUBLISHABLE_KEY=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=
VITE_MSAL_CLIENT_ID=
VITE_OFFICE_RUNTIME_ORIGIN=https://uat-office.capynotebook.com
VITE_EMBED_ORIGIN=https://uat.capy-embed.pages.dev
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=capy-web
SENTRY_URL=https://de.sentry.io/

# Ingest SSH identity. Double-quoted \n escapes allow a multiline private key.
INGEST_HOST=159.195.61.195
INGEST_HOST_USER=capy-ingest
INGEST_HOST_SSH_PORT=22
INGEST_HOST_SSH_PRIVATE_KEY=
INGEST_HOST_KNOWN_HOSTS=
PARSER_BIND_ADDRESS=10.77.0.2
PARSER_TOKEN=
CAPY_INGEST_HOST_ID=netcup-ingest-nonprod
# Parser page cap and OCR page cap: the API serves them in the upload policy
# and the ingest host parser enforces them, both from these values.
CAPY_PARSE_MAX_PAGES=1400
CAPY_PARSE_OCR_PAGE_CAP=500
# Optional parser/worker tuning keys are listed in ingest-host.env.example.

# UAT shares the nonprod parser with local queue consumers at a fixed 1/1/1 cap.
PARSER_PORT=8091
CAPY_INGEST_NONPROD_PROJECT_NAME=capy-ingest-nonprod
CAPY_INGEST_NONPROD_PARSE_SPOOL_VOLUME=capy-ingest_nonprod_parse_spool
# Optional shared tuning keys are listed in ingest-host.nonprod.env.example.

# Local tunnel lookup, not uploaded. Routing stays attached to the tunnel ID.
CLOUDFLARE_TUNNEL_ID=

# Deterministic UAT validation uses only synthetic users/content.
UAT_TARGET_AUTHORIZED=false
UAT_APP_URL=https://uat.capynotebook.com
UAT_API_URL=https://uat-api.capynotebook.com
UAT_COLLAB_URL=wss://uat-collab.capynotebook.com
UAT_ALLOWED_HOSTS=uat.capynotebook.com,uat-api.capynotebook.com,uat-collab.capynotebook.com,uat-ops.capynotebook.com

UAT_OWNER_EMAIL=
UAT_EDITOR_EMAIL=
UAT_VIEWER_EMAIL=
UAT_OTHER_EMAIL=
UAT_SUSPENDED_EMAIL=
UAT_OVER_QUOTA_EMAIL=
UAT_FIXTURE_WORKSPACE_ID=
UAT_FIXTURE_MATERIAL_ID=

# Strix 1.5.3 runs locally only (scripts/review/strix-scan.sh) and never in
# GitHub Actions. STRIX_UAT_AUTH_INSTRUCTIONS is optional synthetic login
# guidance; it is written only to a mode-0600 temp file for the scan.
STRIX_LLM=openai/gpt-5.4
LLM_API_KEY=
STRIX_UAT_AUTH_INSTRUCTIONS=
STRIX_MAX_BUDGET=40

# Exact HTTPS origins permitted to embed the isolated Office runtime (comma-separated).
OFFICE_ALLOWED_PARENT_ORIGINS=https://uat.capynotebook.com,https://local.uat.capynotebook.com
