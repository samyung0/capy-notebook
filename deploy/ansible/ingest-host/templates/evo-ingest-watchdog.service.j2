[Unit]
Description=Evo Notes ingest parser watchdog
Requires=docker.service
After=docker.service evo-ingest.service
Wants=evo-ingest.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-{{ ingest_env_path }}
Environment=COMPOSE_PROJECT_NAME=evo-ingest
Environment=EVO_WATCHDOG_REPO_DIR={{ ingest_repo_dir }}
Environment=EVO_WATCHDOG_ENV_FILE={{ ingest_env_path }}
Environment=EVO_WATCHDOG_RELEASE_ENV_FILE={{ ingest_release_env_path }}
Environment=EVO_WATCHDOG_COMPOSE_FILE={{ ingest_compose_file }}
Environment=EVO_WATCHDOG_PENDING_RELEASE=/opt/evo-ingest/release.pending
ExecStart=/usr/bin/python3 /usr/local/sbin/evo-ingest-watchdog
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
