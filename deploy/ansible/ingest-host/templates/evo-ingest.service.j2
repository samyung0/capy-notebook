[Unit]
Description=Evo Notes ingest host services
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
{% if ingest_configure_wireguard | default(true) %}
Requires=wg-quick@{{ ingest_wireguard_interface }}.service
After=wg-quick@{{ ingest_wireguard_interface }}.service
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
User={{ ingest_service_user }}
Group={{ ingest_service_user }}
WorkingDirectory={{ ingest_repo_dir }}
Environment=COMPOSE_PROJECT_NAME=evo-ingest
ExecStart=/usr/bin/docker compose --env-file {{ ingest_env_path }} --env-file {{ ingest_release_env_path }} -f {{ ingest_compose_file }} up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file {{ ingest_env_path }} --env-file {{ ingest_release_env_path }} -f {{ ingest_compose_file }} down
TimeoutStartSec=3600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
