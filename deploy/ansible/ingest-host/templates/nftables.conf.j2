#!/usr/sbin/nft -f

destroy table inet capy_ingest_filter

table inet capy_ingest_filter {
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    iifname "lo" accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept
    tcp dport 22 accept
    udp dport {{ ingest_wireguard_listen_port }} accept
    iifname "{{ ingest_wireguard_interface }}" accept
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    iifname "docker0" udp dport 53 accept
    iifname "docker0" tcp dport { 53, 80, 443 } accept
    iifname "br-*" udp dport 53 accept
    iifname "br-*" tcp dport { 53, 80, 443 } accept
  }

  chain output {
    type filter hook output priority filter; policy accept;
    # The parsers (uid 10001 in parser/Dockerfile, host networking) convert
    # untrusted Office files; they may only open connections to the parser
    # ports (8090 production, 8091 nonprod) over loopback, which also carries
    # traffic to the host's own WireGuard address. Reject, not drop, so a
    # blocked link fails at once instead of stalling the conversion.
    meta skuid 10001 ct state new oifname "lo" tcp dport { 8090, 8091 } accept
    meta skuid 10001 ct state new reject
  }
}
