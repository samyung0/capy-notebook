# Install as root:evo-ingest with mode 0640. Never commit real values.
PARSER_BIND_ADDRESS=10.77.0.2
PARSER_TOKEN=
DATABASE_URL=postgres://evo:<password>@10.77.0.1:5432/evo?sslmode=disable
REDIS_URL=redis://10.77.0.1:6379/0
# Drive/OneDrive import worker: the gateway published on WireGuard and the same
# PIPELINE_SECRET the gateway holds.
GATEWAY_URL=http://10.77.0.1:8080
PIPELINE_SECRET=
# EVO_IMPORT_JOB_TIMEOUT=600
# Overrides the pipeline's default provider download host list (config.py).
# EVO_IMPORT_DOWNLOAD_HOSTS=
EVO_INGEST_HOST_ID=netcup-ingest-production
EVO_HOST_SAMPLE_ACTIVE_SECONDS=5
EVO_HOST_SAMPLE_IDLE_SECONDS=60
EVO_HOST_SPOOL_SAMPLE_SECONDS=60

B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

EVO_PARSE_METHOD=auto
# Maximum LibreOffice-derived citation-preview PDF (128 MiB).
EVO_OFFICE_PREVIEW_MAX_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_BYTES=268435456
EVO_PARSE_ARTIFACT_MAX_ENTRIES=4096
EVO_PARSE_ARTIFACT_MAX_ENTRY_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_EXPANDED_BYTES=536870912
EVO_PARSE_CONTENT_MAX_BYTES=134217728
EVO_PARSE_CONTENT_MAX_BLOCKS=250000
EVO_PARSE_IMAGE_MAX_BYTES=33554432
EVO_PARSE_IMAGES_MAX_BYTES=268435456
PARSER_TIMEOUT=2400
EVO_PARSE_SLICE_TIMEOUT=600
PARSER_SLOT_TTL=2700
EVO_PARSE_JOB_TIMEOUT=3600
EVO_INGEST_TIMEOUT=1200
EVO_PARSE_SLOTS=4
EVO_INGEST_PROD_PARSE_SPOOL_VOLUME=evo-ingest_parse_spool
EVO_INGEST_PARSER_MODELS_VOLUME=evo-ingest_parser_models
EVO_PARSE_CONCURRENCY=4
EVO_MINERU_SLICE_PAGES=26
EVO_MINERU_PROCESSING_WINDOW_SIZE=26
EVO_MINERU_INTRA_OP_NUM_THREADS=2
EVO_MINERU_INTER_OP_NUM_THREADS=1
EVO_PARSE_COORDINATOR_CONCURRENCY=4
EVO_PARSE_COORDINATOR_MEMORY_LIMIT=512m
EVO_PARSE_COORDINATOR_MEMORY_SWAP_LIMIT=768m
EVO_PARSE_COORDINATOR_CPUS=1.0
EVO_PARSE_COORDINATOR_PIDS_LIMIT=128
WORKER_REPLICAS=4
IMPORT_WORKER_REPLICAS=2
EVO_INGEST_WORKER_MEMORY_LIMIT=1g
EVO_INGEST_WORKER_MEMORY_SWAP_LIMIT=1280m
EVO_INGEST_WORKER_CPUS=1.0
EVO_INGEST_WORKER_PIDS_LIMIT=128
EVO_CAPTION_CONCURRENCY=4

SENTRY_DSN_WORKER=
SENTRY_TRACES_SAMPLE_RATE=0.1
# The release workflow writes this exact 40-character commit to release.env.
# Do not duplicate RELEASE_SHA in this secrets file.

DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# EVO_ELEVENLABS_TRANSCRIPT_VERSION=scribe-v2-1
# EVO_ELEVENLABS_CONCURRENCY_UNITS=12
# EVO_ELEVENLABS_SYNC_TIMEOUT_S=43200
# EVO_AUDIO_MAX_DURATION_SECONDS=36000
# EVO_IMAGE_MAX_PIXELS=100000000
# EVO_TABULAR_TEXT_VERSION=v1
# EVO_CAPTION_VERSION=v2
# Compose mounts this path into both parser and worker containers.
# EVO_PARSE_SHARED_DIR=/var/lib/evo-parse
# EVO_PARSE_ZIP_TTL_HOURS=6
# EVO_PARSE_SOURCE_TTL_HOURS=2
EMBEDDING_DIM=2560
