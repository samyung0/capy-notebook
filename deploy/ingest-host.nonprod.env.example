# Shared local/UAT stack settings for the Netcup ingest host.
# Install as /opt/capy-ingest/nonprod.env with mode 0640. Never commit real values.
# Production database, Redis, B2, and provider credentials do not belong here.

CAPY_INGEST_NONPROD_PROJECT_NAME=capy-ingest-nonprod
CAPY_INGEST_HOST_ID=netcup-ingest-nonprod
CAPY_HOST_SAMPLE_ACTIVE_SECONDS=5
CAPY_HOST_SAMPLE_IDLE_SECONDS=60
CAPY_HOST_SPOOL_SAMPLE_SECONDS=60
PARSER_PORT=8091
RELEASE_SHA=0000000000000000000000000000000000000000
PARSER_TOKEN=replace-me

# Copy ingest-host.nonprod.queue.env.example to each path. Local and UAT keep
# separate application data and provider credentials while sharing compute.
CAPY_INGEST_LOCAL_ENV_FILE=/opt/capy-ingest/local.queue.env
CAPY_INGEST_UAT_ENV_FILE=/opt/capy-ingest/uat.queue.env

CAPY_INGEST_NONPROD_PARSE_SPOOL_VOLUME=capy-ingest_nonprod_parse_spool
CAPY_INGEST_PARSER_MODELS_VOLUME=capy-ingest_parser_models
CAPY_PARSE_METHOD=auto
# Compose hard-caps active coordinator work, parser concurrency, Redis
# admission, and ingestion at one across local and UAT.
CAPY_PARSE_JOB_TIMEOUT=3600
CAPY_INGEST_TIMEOUT=1200
CAPY_MINERU_SLICE_PAGES=26
CAPY_MINERU_PROCESSING_WINDOW_SIZE=26
CAPY_MINERU_INTRA_OP_NUM_THREADS=2
CAPY_MINERU_INTER_OP_NUM_THREADS=1
CAPY_INGEST_NONPROD_PARSER_MEMORY_LIMIT=6g
CAPY_INGEST_NONPROD_PARSER_MEMORY_SWAP_LIMIT=8g
CAPY_INGEST_NONPROD_PARSER_CPUS=2.0
CAPY_INGEST_NONPROD_COORDINATOR_MEMORY_LIMIT=384m
CAPY_INGEST_NONPROD_COORDINATOR_MEMORY_SWAP_LIMIT=512m
CAPY_INGEST_NONPROD_COORDINATOR_CPUS=0.5
CAPY_INGEST_NONPROD_COORDINATOR_PIDS_LIMIT=64
CAPY_INGEST_NONPROD_WORKER_MEMORY_LIMIT=1g
CAPY_INGEST_NONPROD_WORKER_MEMORY_SWAP_LIMIT=1280m
CAPY_INGEST_NONPROD_WORKER_CPUS=1.0
CAPY_INGEST_NONPROD_WORKER_PIDS_LIMIT=128
