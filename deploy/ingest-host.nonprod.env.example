# Shared local/UAT stack settings for the Netcup ingest host.
# Install as /opt/evo-ingest/nonprod.env with mode 0640. Never commit real values.
# Production database, Redis, B2, and provider credentials do not belong here.

EVO_INGEST_NONPROD_PROJECT_NAME=evo-ingest-nonprod
EVO_INGEST_HOST_ID=netcup-ingest-nonprod
EVO_HOST_SAMPLE_ACTIVE_SECONDS=5
EVO_HOST_SAMPLE_IDLE_SECONDS=60
EVO_HOST_SPOOL_SAMPLE_SECONDS=60
PARSER_PORT=8091
RELEASE_SHA=0000000000000000000000000000000000000000
PARSER_TOKEN=replace-me

# Copy ingest-host.nonprod.queue.env.example to each path. Local and UAT keep
# separate application data and provider credentials while sharing compute.
EVO_INGEST_LOCAL_ENV_FILE=/opt/evo-ingest/local.queue.env
EVO_INGEST_UAT_ENV_FILE=/opt/evo-ingest/uat.queue.env

EVO_INGEST_NONPROD_PARSE_SPOOL_VOLUME=evo-ingest_nonprod_parse_spool
EVO_INGEST_PARSER_MODELS_VOLUME=evo-ingest_parser_models
EVO_PARSE_METHOD=auto
# Compose hard-caps active coordinator work, parser concurrency, Redis
# admission, and ingestion at one across local and UAT.
EVO_PARSE_JOB_TIMEOUT=3600
EVO_INGEST_TIMEOUT=1200
EVO_MINERU_SLICE_PAGES=26
EVO_MINERU_PROCESSING_WINDOW_SIZE=26
EVO_MINERU_INTRA_OP_NUM_THREADS=2
EVO_MINERU_INTER_OP_NUM_THREADS=1
EVO_INGEST_NONPROD_PARSER_MEMORY_LIMIT=6g
EVO_INGEST_NONPROD_PARSER_MEMORY_SWAP_LIMIT=8g
EVO_INGEST_NONPROD_PARSER_CPUS=2.0
EVO_INGEST_NONPROD_COORDINATOR_MEMORY_LIMIT=384m
EVO_INGEST_NONPROD_COORDINATOR_MEMORY_SWAP_LIMIT=512m
EVO_INGEST_NONPROD_COORDINATOR_CPUS=0.5
EVO_INGEST_NONPROD_COORDINATOR_PIDS_LIMIT=64
EVO_INGEST_NONPROD_WORKER_MEMORY_LIMIT=1g
EVO_INGEST_NONPROD_WORKER_MEMORY_SWAP_LIMIT=1280m
EVO_INGEST_NONPROD_WORKER_CPUS=1.0
EVO_INGEST_NONPROD_WORKER_PIDS_LIMIT=128
