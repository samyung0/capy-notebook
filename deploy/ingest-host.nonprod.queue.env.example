# Copy once for local and again for UAT. Each copy describes one app server's
# queue, blob storage, and provider credentials. Never use production values.

DATABASE_URL=postgres://replace-me
REDIS_URL=redis://replace-me
# Drive/OneDrive import worker: this environment's gateway and its PIPELINE_SECRET.
GATEWAY_URL=http://replace-me:8080
PIPELINE_SECRET=replace-me
# The user-file bucket is Cloudflare R2; the B2_* names stay (Q487).
B2_ENDPOINT=https://replace-me.eu.r2.cloudflarestorage.com
B2_REGION=auto
B2_BUCKET=replace-me-nonprod
B2_KEY_ID=replace-me
B2_APP_KEY=replace-me

DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Alibaba Model Studio (Singapore workspace) transcribes uploaded audio in the
# ingest worker: the key, and the workspace's .../compatible-mode/v1 URL.
ALIBABA_MODELSTUDIO_KEY=
ALIBABA_MODELSTUDIO_URL=
SENTRY_DSN=
