# Copy to /opt/capy-layout/.env on the ingest host, mode 0600 (runbook §7.6).
# The commit the image is built from.
LAYOUT_REVISION=
LAYOUT_BIND_ADDRESS=10.77.0.2
# openssl rand -hex 32. The same value goes in UAT's and production's GitHub
# environments as CAPY_LAYOUT_TOKEN.
CAPY_LAYOUT_TOKEN=
# Sizes wait for the capacity test (bench/extraction/reports/2026-11-04-layout-models.md).
LAYOUT_THREADS=2
LAYOUT_WORKERS=2
LAYOUT_QUEUE_DEPTH=8
LAYOUT_MAX_BYTES=4194304
LAYOUT_MAX_PIXELS=5000000
LAYOUT_MEMORY_LIMIT=2g
LAYOUT_CPUS=4
