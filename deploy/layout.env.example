# Copy to /opt/capy-layout/.env on the ingest host, mode 0600 (runbook §7.6).
# The commit the image is built from.
LAYOUT_REVISION=
LAYOUT_BIND_ADDRESS=10.77.0.2
# openssl rand -hex 32. The same value goes in UAT's and production's GitHub
# environments as CAPY_LAYOUT_TOKEN.
CAPY_LAYOUT_TOKEN=
# Sizes from the capacity test (bench/extraction/reports/2026-11-04-layout-capacity.md):
# two inferences of two threads, depth 4 for each, 1 GiB for each. With the int8
# model (bench/extraction/reports/2026-11-10-layout-int8.md) one thread is the
# cheapest a page, 528 CPU-ms; two cost the same and four 11% more, so more
# threads only shorten one page's wait. One process running a page at a time
# peaks at 425 MB, 544 MB with the float model.
LAYOUT_THREADS=2
LAYOUT_WORKERS=2
LAYOUT_QUEUE_DEPTH=8
LAYOUT_MAX_BYTES=4194304
LAYOUT_MAX_PIXELS=5000000
LAYOUT_MEMORY_LIMIT=2g
