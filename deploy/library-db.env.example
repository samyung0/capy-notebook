# Copy to /opt/capy-library-db/.env on the ingest host, mode 0600.
# Generate both passwords there: openssl rand -hex 24
LIBRARY_DB_BIND_ADDRESS=10.77.0.2
LIBRARY_DB_PORT=5433
LIBRARY_DB_PASSWORD=
LIBRARY_DB_READER_PASSWORD=
LIBRARY_DB_MEMORY_LIMIT=3g
LIBRARY_DB_SHARED_BUFFERS=768MB
LIBRARY_DB_EFFECTIVE_CACHE=2GB
LIBRARY_DB_MAINTENANCE_WORK_MEM=512MB
LIBRARY_DB_MAX_CONNECTIONS=60
