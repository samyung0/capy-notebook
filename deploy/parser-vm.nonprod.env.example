# Copy this file twice on the Netcup VM: one local file and one UAT file.
# Never put production database, B2, Redis, or provider credentials here.
# Both copies keep EVO_NONPROD_PARSE_SPOOL_VOLUME=evo_parse_nonprod.

# Use evo-parser-local / port 8091 for local, evo-parser-uat / port 8092 for UAT.
EVO_NONPROD_PROJECT_NAME=evo-parser-local
PARSER_PORT=8091
APP_ENV=development
RELEASE_SHA=0000000000000000000000000000000000000000
PARSER_TOKEN=replace-me

DATABASE_URL=postgres://replace-me
REDIS_URL=redis://replace-me
B2_ENDPOINT=https://replace-me.backblazeb2.com
B2_REGION=replace-me
B2_BUCKET=replace-me-nonprod
B2_KEY_ID=replace-me
B2_APP_KEY=replace-me

DEEPSEEK_API_KEY=
DEEPINFRA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_ID=
SENTRY_DSN_WORKER=

EVO_NONPROD_PARSE_SPOOL_VOLUME=evo_parse_nonprod
EVO_PARSER_MODELS_VOLUME=evo-parser_parser_models
EVO_NONPROD_PARSER_MEMORY_LIMIT=6g
EVO_NONPROD_PARSER_CPUS=2.0
EVO_NONPROD_WORKER_MEMORY_LIMIT=2g
EVO_NONPROD_WORKER_CPUS=1.0
