{
  "schemaVersion": 1,
  "subject": "Your Capy Notebook account will be deleted on {{.DeletionDate}}",
  "preview": "Contact support before then if this was a mistake.",
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Your account is scheduled for deletion"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "We received your request to delete your Capy Notebook account. Your account is locked now. On the date below it will be permanently deleted with all of its workspaces, files, materials and study data."
          }
        ]
      },
      {
        "type": "section",
        "attrs": {
          "backgroundColor": "#fdf0ef",
          "borderColor": "#f2d4d1",
          "borderWidth": 1,
          "borderRadius": 10,
          "paddingTop": 14,
          "paddingRight": 16,
          "paddingBottom": 14,
          "paddingLeft": 16,
          "marginBottom": 20
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Deletion date: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "DeletionDate",
                  "label": "Deletion date",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Days left: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "GraceDays",
                  "label": "Grace days",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Changed your mind? Contact support before "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "DeletionDate",
              "label": "Deletion date",
              "required": true
            }
          },
          {
            "type": "text",
            "text": " and we can restore your account. After that date nothing can be recovered."
          }
        ]
      },
      {
        "type": "button",
        "attrs": {
          "text": "Contact support",
          "url": "OpenURL",
          "isUrlVariable": true,
          "alignment": "left",
          "variant": "filled",
          "borderRadius": "smooth"
        }
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "You got this email because someone asked to delete your Capy Notebook account. If that wasn't you, contact support right away."
          }
        ]
      }
    ]
  }
}
