{
  "schemaVersion": 1,
  "subject": "Your Capy Notebook Pro plan ends on {{.EndsOn}}",
  "preview": "You keep Pro until then. Here's what changes after.",
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Your Pro plan ends on "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "EndsOn",
              "label": "Ends on",
              "required": true
            }
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You cancelled Capy Notebook Pro. You keep everything Pro includes until "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "EndsOn",
              "label": "Ends on",
              "required": true
            }
          },
          {
            "type": "text",
            "text": ", then your account moves to the Free plan."
          }
        ]
      },
      {
        "type": "section",
        "attrs": {
          "backgroundColor": "#fdf5e4",
          "borderColor": "#f0e0bd",
          "borderWidth": 1,
          "borderRadius": 10,
          "paddingTop": 14,
          "paddingRight": 16,
          "paddingBottom": 14,
          "paddingLeft": 16,
          "marginBottom": 20
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "What changes on ",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "EndsOn",
                  "label": "Ends on",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Storage limit drops to 100 MB. You use "
                      },
                      {
                        "type": "variable",
                        "attrs": {
                          "id": "StorageUsed",
                          "label": "Storage used",
                          "required": true
                        },
                        "marks": [
                          {
                            "type": "bold"
                          }
                        ]
                      },
                      {
                        "type": "text",
                        "text": " now."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "AI credits drop to 1,000 a month."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Largest file drops to 10 MB."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "If your files are still over 100 MB then, you get 14 days to free up space before your account becomes read-only."
          }
        ]
      },
      {
        "type": "button",
        "attrs": {
          "text": "Manage subscription",
          "url": "OpenURL",
          "isUrlVariable": true,
          "alignment": "left",
          "variant": "filled",
          "borderRadius": "smooth"
        }
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "You got this email because you cancelled Capy Notebook Pro."
          }
        ]
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "Stop billing emails",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "UnsubscribeURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
