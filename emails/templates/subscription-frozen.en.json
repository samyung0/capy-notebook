                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Free plan limit: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "StorageLimit",
                  "label": "Storage limit",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "attrs": {
          "text": "Manage subscription",
          "url": "OpenURL",
          "isUrlVariable": true,
          "alignment": "left",
          "variant": "filled",
          "borderRadius": "smooth"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Or delete files until you're under "
