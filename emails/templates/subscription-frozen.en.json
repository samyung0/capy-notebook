      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "Stop billing emails",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "UnsubscribeURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ]
          }
        ]
      }
