{
  "schemaVersion": 1,
  "subject": "Your Capy Notebook account is read-only",
  "preview": "Free up space or resubscribe to edit again.",
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Your account is read-only"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Your storage buffer ended on "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "GraceEndsAt",
              "label": "Buffer ends",
              "required": true
            }
          },
          {
            "type": "text",
            "text": ", and your files still use more than the Free plan's "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "StorageLimit",
              "label": "Storage limit",
              "required": true
            }
          },
          {
            "type": "text",
            "text": ". Your account stays read-only until you're back under the limit."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Still works",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Viewing and downloading files"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Deleting files to free up space"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Workspace chat, quizzes and reviews"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Billing and account settings"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Paused",
            "marks": [
              {
                "type": "bold"
              }
            ]
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Uploading and creating files"
                  }
                ]
              }
