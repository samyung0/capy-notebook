{
  "schemaVersion": 1,
  "subject": "You're on Capy Notebook Pro",
  "preview": "Your Pro plan is active. Here's what changed.",
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Welcome to Pro"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Thanks for subscribing. Your Pro plan is active now, and these limits apply to your account:"
          }
        ]
      },
      {
        "type": "section",
        "attrs": {
          "backgroundColor": "#effae6",
          "borderColor": "#d5eec1",
          "borderWidth": 1,
          "borderRadius": 10,
          "paddingTop": 14,
          "paddingRight": 16,
          "paddingBottom": 14,
          "paddingLeft": 16,
          "marginBottom": 20
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Storage: "
              },
              {
                "type": "text",
                "text": "1 GB",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " (was 100 MB)"
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "AI credits: "
              },
              {
                "type": "text",
                "text": "20,000 a month",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": " (was 1,000)"
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Workspaces you own: "
              },
              {
                "type": "text",
                "text": "up to 50",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Largest file: "
              },
              {
                "type": "text",
                "text": "30 MB",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Renews on: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "RenewsOn",
                  "label": "Renews on",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "You can see invoices and change or cancel your plan any time in Billing."
          }
        ]
      },
      {
        "type": "button",
        "attrs": {
          "text": "Manage subscription",
          "url": "OpenURL",
          "isUrlVariable": true,
          "alignment": "left",
          "variant": "filled",
          "borderRadius": "smooth"
        }
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "You got this email because you subscribed to Capy Notebook Pro."
          }
        ]
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "Stop billing emails",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "UnsubscribeURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
