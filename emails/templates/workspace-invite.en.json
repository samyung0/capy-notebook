{
  "schemaVersion": 1,
  "subject": "You're invited to join {{.WorkspaceName}} on Capy Notebook",
  "preview": "You have a new Capy Notebook workspace invitation.",
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              { "type": "bold" },
              { "type": "textStyle", "attrs": { "color": "#5e5cdb" } }
            ],
            "text": "Capy Notebook"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": { "level": 1 },
        "content": [
          { "type": "text", "text": "You have a workspace invitation" }
        ]
      },
      {
        "type": "paragraph",
        "content": [{ "type": "text", "text": "Hello," }]
      },
      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "You have been invited to join " },
          {
            "type": "variable",
            "attrs": {
              "id": "WorkspaceName",
              "label": "Workspace name",
              "required": true
            }
          },
          { "type": "text", "text": " on Capy Notebook." }
        ]
      },
      {
        "type": "button",
        "attrs": {
          "text": "View invitation",
          "url": "InviteURL",
          "isUrlVariable": true,
          "alignment": "left",
          "variant": "filled",
          "borderRadius": "smooth"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Open this link if the button does not work: "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "InviteURL",
              "label": "Invite URL",
              "required": true
            },
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "InviteURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ]
          }
        ]
      },
      { "type": "horizontalRule" },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "You received this message because a Capy Notebook workspace invited you."
          }
        ]
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "UnsubscribeURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ],
            "text": "Manage product email preferences"
          }
        ]
      }
    ]
  }
}
