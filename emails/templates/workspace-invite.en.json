{
  "schemaVersion": 1,
  "subject": "{{.InviterName}} invited you to {{.WorkspaceName}} on Capy Notebook",
  "preview": "Join the workspace to study its files together.",
  "content": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 3
        },
        "content": [
          {
            "type": "text",
            "text": "Join "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "WorkspaceName",
              "label": "Workspace name",
              "required": true
            }
          },
          {
            "type": "text",
            "text": " on Capy Notebook"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "variable",
            "attrs": {
              "id": "InviterName",
              "label": "Inviter name",
              "required": true
            },
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " invited you to the "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "WorkspaceName",
              "label": "Workspace name",
              "required": true
            },
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": " workspace."
          }
        ]
      },
      {
        "type": "section",
        "attrs": {
          "backgroundColor": "#f3f0fb",
          "borderColor": "#e2dbf6",
          "borderWidth": 1,
          "borderRadius": 10,
          "paddingTop": 14,
          "paddingRight": 16,
          "paddingBottom": 14,
          "paddingLeft": 16,
          "marginBottom": 20
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Workspace: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "WorkspaceName",
                  "label": "Workspace name",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Access: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "Access",
                  "label": "Access",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "Invited by: "
              },
              {
                "type": "variable",
                "attrs": {
                  "id": "InviterName",
                  "label": "Inviter name",
                  "required": true
                },
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "attrs": {
          "text": "View invitation",
          "url": "InviteURL",
          "isUrlVariable": true,
          "alignment": "left",
          "variant": "filled",
          "borderRadius": "smooth"
        }
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Button not working? Open this link: "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "InviteURL",
              "label": "Invite URL",
              "required": true
            },
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "InviteURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "horizontalRule"
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "You got this email because "
          },
          {
            "type": "variable",
            "attrs": {
              "id": "InviterName",
              "label": "Inviter name",
              "required": true
            }
          },
          {
            "type": "text",
            "text": " invited you to a Capy Notebook workspace. If you weren't expecting it, you can ignore it."
          }
        ]
      },
      {
        "type": "footer",
        "content": [
          {
            "type": "text",
            "text": "Stop workspace invitation emails",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "UnsubscribeURL",
                  "isUrlVariable": true,
                  "target": "_blank",
                  "rel": "noopener noreferrer nofollow"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
