    "lint-staged": "^17.3.0",
    "msw": "^2.4.0",
    "orval": "^8.22.0",
    "prettier": "^3.9.6",
    "react-email": "^6.9.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
