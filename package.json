  "name": "evo-notes",
  "scripts": {
    "predev": "pnpm run office:prepare",
    "dev": "vite",
    "prebuild": "pnpm run office:prepare",
    "build": "tsc -b && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "fmt": "biome format --write .",
    "fmt:go": "cd server && go fmt ./...",
    "fmt:py": "uv --native-tls run --with ruff ruff format pipeline && uv --native-tls run --with ruff ruff check --fix pipeline",
    "pretypecheck": "pnpm run office:prepare",
    "typecheck": "tsc -b --noEmit",
    "pretest": "pnpm run office:prepare",
    "test": "vitest run --dir src && vitest run --dir e2e/perf",
    "test:collaboration": "vitest run --dir collaboration",
    "test:import-relay": "pnpm --filter @evo-notes/drive-import-relay test",
    "test:pipeline": "uv run --extra test pytest",
    "test:pipeline:offline": "uv run --extra test pytest -q -m \"not cassette and not integration\"",
    "test:pipeline:replay": "uv run --extra test python pipeline/scripts/replay_model_cassettes.py",
    "test:go": "cd server && go run ./cmd/testdb",
    "e2e": "playwright test",
    "e2e:slow": "playwright test --workers=1",
    "e2e:ui": "playwright test --ui",
    "e2e:editor": "playwright test --config=e2e/editor/playwright.editor.config.ts",
    "e2e:quality": "playwright test e2e/quality",
    "e2e:uat": "playwright test --config=e2e/uat/playwright.uat.config.ts",
    "e2e:install": "playwright install chromium",
    "email:build": "tsx scripts/build-emails.ts",
    "email:check": "pnpm run email:build && tsx scripts/check-emails.ts",
    "email:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n/paraglide",
    "email:dev": "pnpm run email:compile && email dev --dir emails",
    "model:certify": "uv run --extra test python pipeline/scripts/certify_agentic_loop_model.py",
    "api:docs": "node scripts/serve-openapi.mjs",
    "api:docs:generate": "pnpm gen:openapi && node scripts/serve-openapi.mjs",
    "review:local": "scripts/review/run-local-tests.sh fast",
    "review:local:full": "scripts/review/run-local-tests.sh full",
    "review:preflight": "scripts/review/preflight.sh local",
    "review:uat:smoke": "scripts/review/remote-smoke.sh",
    "review:validate-boundaries": "node --test scripts/review/validate-review-boundaries.test.mjs",
    "review:validate-strix": "node --test scripts/review/validate-strix-run.test.mjs",
    "perf": "playwright test --config=e2e/perf/playwright.perf.config.ts",
    "chaos:peers": "pnpm --filter @evo-notes/collaboration chaos --",
    "check": "ultracite check && pnpm run typecheck",
    "gen:openapi": "cd server && go run ./cmd/openapi -o ../openapi.yaml -python-surfaces ../pipeline/pipeline/generated/surface.py",
    "gen:api": "pnpm gen:api:clean && orval && node scripts/sync-surface-contracts.mjs",
    "gen:api:clean": "node scripts/clean-api-gen.mjs",
    "gen:api:full": "pnpm gen:openapi && pnpm gen:api",
    "fix": "ultracite fix",
    "prepare": "husky",
    "deploy:import-relay": "pnpm --filter @evo-notes/drive-import-relay deploy",
    "office:prepare": "node scripts/prepare-betteroffice.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,scss,md,mdx}": [
      "ultracite fix --skip=types"
    ],
    "*.go": "gofmt -w",
    "*.py": [
      "uv run --with ruff ruff format",
      "uv run --with ruff ruff check --fix"
    ],
    "*.{yml,yaml}": "prettier --write"
  },
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
