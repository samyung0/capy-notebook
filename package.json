    "ultracite": "7.9.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "name": "evo-notes",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fmt": "biome format --write .",
    "fmt:go": "cd server && go fmt ./...",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --dir src",
    "test:collaboration": "vitest run --dir collaboration",
    "test:cloudflare-relay": "node --test cloudflare/mineru-relay/test/*.test.js",
    "test:go": "cd server && go run gotest.tools/gotestsum@v1.12.3 --format=testdox -- -p 1 ./...",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:editor": "playwright test --config=e2e/editor/playwright.editor.config.ts",
    "e2e:install": "playwright install chromium",
    "email:build": "tsx scripts/build-emails.ts",
    "email:check": "pnpm run email:build && tsx scripts/check-emails.ts",
    "email:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/i18n/paraglide",
    "email:dev": "pnpm run email:compile && email dev --dir emails",
    "perf": "playwright test --config=e2e/perf/playwright.perf.config.ts",
    "chaos:peers": "pnpm --filter @evo-notes/collaboration chaos --",
    "check": "ultracite check && pnpm run typecheck",
    "gen:openapi": "cd server && go run ./cmd/openapi -o ../openapi.yaml",
    "gen:api": "orval",
    "gen:api:msw": "pnpm gen:openapi && pnpm gen:api",
    "gen:api:watch": "orval --watch",
    "fix": "ultracite fix",
    "pipeline:test": "uv run --extra test pytest",
    "pipeline:test:offline": "uv run --extra test pytest -q -m \"not cassette\""
  },
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
