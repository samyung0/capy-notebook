# Python worker + retrieval service config. NOT auto-loaded — export these, use
# docker-compose, or `uv run --env-file .env -- <cmd>`. Lists every var the
# pipeline reads (pipeline/config.py).

# ── Shared infra ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://evo:evo@localhost:5432/evo?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Backblaze B2 source-object storage. Worker downloads each object key.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ── Gateway callback ────────────────────────────────────────────────────────
# The chat agent's generate_material tool POSTs to the Go gateway instead of
# writing materials directly, so authorization and storage quota stay there.
# Unset either value and the tool is not offered to the model at all.
GATEWAY_URL=http://localhost:8080
PIPELINE_SECRET=dev-pipeline-secret

# ── Worker ──────────────────────────────────────────────────────────────────
EVO_POLL_INTERVAL=2.0

# ── Chunking ────────────────────────────────────────────────────────────────
# Sizes are in characters. Blocks are never split below chunk_chars, so a table
# or long paragraph stays whole.
# EVO_CHUNK_CHARS=1600
# EVO_CHUNK_OVERLAP_CHARS=200
# EVO_CHUNK_MIN_CHARS=160

# ── Modal MinerU GPU parse service (deploy modal/mineru_app.py first) ───────
# Both parse modes are MinerU on our own GPU and return the same bundle (page
# index, bounding boxes, extracted images); they differ in backend and cost.
# Deploying modal/mineru_app.py publishes two web endpoints — point each var at
# the matching one.
MODAL_PARSE_URL=            # parseMode=accurate — hybrid VLM
MODAL_FAST_PARSE_URL=       # parseMode=fast — pipeline OCR
MODAL_PARSE_TOKEN=
# Generous on purpose: a request can queue behind other documents sharing the
# container before its own parse starts.
MODAL_PARSE_TIMEOUT=900
EVO_PARSE_METHOD=auto

# ── Embeddings: OpenRouter (OpenAI-compatible /embeddings) ──────────────────
# EMBEDDING_DIM must match halfvec(N) in server/migrations/0001_init.sql;
# changing it requires re-ingesting every file. 2560 = Qwen3-Embedding-4B.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EVO_MODEL_EMBEDDING=qwen/qwen3-embedding-4b
EMBEDDING_DIM=2560
# EVO_EMBEDDING_BATCH=64

# ── Text LLM: DeepSeek (OpenAI-compatible) ──────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Summaries, concept extraction, and queries use the flash model.
EVO_MODEL_EXTRACTION=deepseek-v4-flash
EVO_QUERY_MODEL=deepseek-v4-flash

# ── Retrieval tuning ────────────────────────────────────────────────────────
# EVO_SEARCH_CANDIDATES=40    # per-branch candidates before rank fusion
# EVO_SEARCH_TOP_K=8          # passages handed to the model
# EVO_SEARCH_PER_FILE_CAP=3   # stops one long document flooding a result set
# EVO_AGENT_MAX_STEPS=4       # tool-calling rounds per chat turn

# ── Vision / image captions: Gemini (OpenAI-compatible endpoint) ────────────
# Captioning is chosen per file at upload time. Every figure that survives the
# filters in pipeline/parse/figures.py is described — the filters, not a count,
# are what bound the cost.
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVO_MODEL_IMAGE_CAPTION=gemini-3.1-flash-lite-preview
# Fallback for jobs that carry no per-file choice (older jobs, cloud imports).
# EVO_CAPTION_IMAGES=false
# EVO_CAPTION_CONCURRENCY=8   # wall clock, not price, is the binding constraint
# EVO_CAPTION_MAX_EDGE=1280   # longest edge sent to the model
# EVO_CAPTION_MAX_PER_FILE=0  # safety valve for a pathological file; 0 = off
# EVO_CAPTION_VERSION=v1      # bump to invalidate every cached caption
