# Python worker + retrieval service config. NOT auto-loaded — export these, use
# docker-compose, or `uv run --env-file .env -- <cmd>`. Lists every var the
# pipeline reads (pipeline/config.py, pipeline/obs.py, pipeline/registry.py).
#
# Model identity and credit multipliers come from model_configs — env never
# names a model. Every surface resolves an exact (provider_slug, model_slug, version) pin: chat,
# generate and editor from the gateway per request; ingest and vision from the
# job payload, snapshotted at enqueue; embedding from the workspace row, fixed at
# creation. A surface that cannot resolve its pin fails instead of falling back,
# because the fallback would run a model nobody priced. Platform API keys stay
# in env, looked up by provider_slug. User-supplied keys are stored encrypted
# in Postgres and decrypted here with LLM_CREDENTIALS_KEY. Unknown slugs fail
# — they must not fall through to DEEPSEEK_API_KEY.

# ── Shared infra ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://evo:evo@localhost:5432/evo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# RELEASE_SHA=
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# Backblaze B2 source-object storage. Worker downloads each object key.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ── Gateway callback ────────────────────────────────────────────────────────
# The chat agent's generate_material tool POSTs to the Go gateway instead of
# writing materials directly, so authorization and storage quota stay there.
# Unset either value and the tool is not offered to the model at all.
GATEWAY_URL=http://localhost:8080
PIPELINE_SECRET=dev-pipeline-secret
# Same value as the Go gateway. Retrieval decrypts user_llm_credentials here.
# LLM_CREDENTIALS_KEY=

# ── Worker ──────────────────────────────────────────────────────────────────
EVO_POLL_INTERVAL=2.0
# Interactive browser requests fail promptly; background ingest keeps a wider
# provider window and uses the job's three-attempt retry budget.
# EVO_INTERACTIVE_PROVIDER_TIMEOUT_S=25
# EVO_INGEST_PROVIDER_TIMEOUT_S=120
# Durable caption cache and local parse spool TTLs.
# EVO_CAPTION_CACHE_TTL_DAYS=90
# EVO_PARSE_ZIP_TTL_HOURS=6
# EVO_PARSE_SOURCE_TTL_HOURS=2

# ── Chunking ────────────────────────────────────────────────────────────────
# Sizes are in characters. Blocks are never split below chunk_chars, so a table
# or long paragraph stays whole.
# EVO_CHUNK_CHARS=1600
# EVO_CHUNK_OVERLAP_CHARS=200
# EVO_CHUNK_MIN_CHARS=160

# ── Persistent CPU parse service ─────────────────────────────────────────────
PARSER_URL=http://10.77.0.2:8090/file_parse
PARSER_TOKEN=
# A slice gets 10 execution minutes; queue wait does not count. The outer
# request, Redis lease, parse job, and ingest continuation keep separate bounds.
PARSER_TIMEOUT=2400
EVO_PARSE_SLICE_TIMEOUT=600
PARSER_SLOT_TTL=2700
EVO_PARSE_JOB_TIMEOUT=3600
EVO_INGEST_TIMEOUT=1200
EVO_PARSE_COORDINATOR_CONCURRENCY=4
EVO_PARSE_METHOD=auto
# Must name the same mounted directory in the worker and parser containers.
EVO_PARSE_SHARED_DIR=/var/lib/evo-parse
# Shared local/UAT queue consumers set this to one mounted directory. Leave it
# unset in production, where replica counts and parser admission own capacity.
# EVO_SHARED_CAPACITY_LOCK_DIR=/var/lib/evo-parse/capacity
# Maximum LibreOffice-derived citation-preview PDF (128 MiB).
EVO_OFFICE_PREVIEW_MAX_BYTES=134217728
# Generated parser ZIP and extraction budgets (256 MiB compressed, 512 MiB expanded).
EVO_PARSE_ARTIFACT_MAX_BYTES=268435456
EVO_PARSE_ARTIFACT_MAX_ENTRIES=4096
EVO_PARSE_ARTIFACT_MAX_ENTRY_BYTES=134217728
EVO_PARSE_ARTIFACT_MAX_EXPANDED_BYTES=536870912
EVO_PARSE_CONTENT_MAX_BYTES=134217728
EVO_PARSE_CONTENT_MAX_BLOCKS=250000
EVO_PARSE_IMAGE_MAX_BYTES=33554432
EVO_PARSE_IMAGES_MAX_BYTES=268435456
# Four coordinators may submit documents; the parser runs at most four slices.
EVO_PARSE_SLOTS=4

# ── Provider keys (elitellm platformEnv names) ─────────────────────────────
# Credentials only. WHICH model runs is a model_configs pin, not an env URL.
# Embeddings stay on the workspace pin for life; a new model needs a new
# vector table.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=
GEMINI_API_KEY=
EMBEDDING_DIM=2560
# EVO_EMBEDDING_BATCH=64

# ── Retrieval tuning ────────────────────────────────────────────────────────
# EVO_SEARCH_CANDIDATES=40    # per-branch candidates before rank fusion
# EVO_SEARCH_TOP_K=8          # passages handed to the model
# EVO_SEARCH_PER_FILE_CAP=3   # stops one long document flooding a result set
# EVO_AGENT_MAX_STEPS=12      # tool-calling rounds per chat turn
# EVO_LLM_INPUT_BUDGET_TOKENS=50000  # pre-model context gathering budget

# ── Vision / image captions ────────────────────────────────────────────────
# Captioning is chosen per file at upload time. The vision pin reads
# DEEPINFRA_API_KEY through the exact ZAI/GLM routing exception.
# EVO_CAPTION_CONCURRENCY=4   # two production workers keep the host-wide cap at 8
# EVO_CAPTION_MAX_EDGE=1280   # longest edge sent to the model
# EVO_CAPTION_MAX_PER_FILE=0  # safety valve for a pathological file; 0 = off
# EVO_CAPTION_VERSION=v2      # bump to invalidate every cached caption
# Standalone images are captioned on this worker with the same pinned vision
# model. This caps decoded pixels, not compressed upload bytes.
# EVO_IMAGE_MAX_PIXELS=100000000

# ── Audio transcription / tabular text ─────────────────────────────────────
# The worker submits uploaded audio to asynchronous ElevenLabs Scribe v2.
# Never expose the API key or webhook secret to the browser.
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_WEBHOOK_ID=
# EVO_ELEVENLABS_TRANSCRIPT_VERSION=scribe-v2-1
# EVO_ELEVENLABS_CONCURRENCY_UNITS=12
# EVO_AUDIO_MAX_DURATION_SECONDS=36000
# EVO_TABULAR_TEXT_VERSION=v1
