# Python worker + retrieval service config. NOT auto-loaded — export these, use
# docker-compose, or `uv run --env-file .env -- <cmd>`. Lists every var the
# pipeline reads (pipeline/config.py, pipeline/obs.py, pipeline/registry.py).
#
# Model identity and credit multipliers come from model_configs — env never
# names a model. Every surface resolves an exact (model_key, version) pin: chat,
# generate and editor from the gateway per request; ingest and vision from the
# job payload, snapshotted at enqueue; embedding from the workspace row, fixed at
# creation. A surface that cannot resolve its pin fails instead of falling back,
# because the fallback would run a model nobody priced. Platform API keys stay
# in env, looked up by provider_slug. User-supplied keys are stored encrypted
# in Postgres and decrypted here with LLM_CREDENTIALS_KEY. Unknown slugs fail
# — they must not fall through to DEEPSEEK_API_KEY.

# ── Shared infra ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://evo:evo@localhost:5432/evo?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# RELEASE_SHA=
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# Backblaze B2 source-object storage. Worker downloads each object key.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=

# ── Gateway callback ────────────────────────────────────────────────────────
# The chat agent's generate_material tool POSTs to the Go gateway instead of
# writing materials directly, so authorization and storage quota stay there.
# Unset either value and the tool is not offered to the model at all.
GATEWAY_URL=http://localhost:8080
PIPELINE_SECRET=dev-pipeline-secret
# Same value as the Go gateway. Retrieval decrypts user_llm_credentials here.
# LLM_CREDENTIALS_KEY=

# ── Worker ──────────────────────────────────────────────────────────────────
EVO_POLL_INTERVAL=2.0
# Per-call bound for chat/embed/vision, so a hung provider cannot hold a lease.
# EVO_PROVIDER_TIMEOUT_S=120
# Artifact cache TTLs. The gateway sweeps on the same two variables, so set them
# in both places or neither — whichever process runs the sweep decides.
# EVO_CAPTION_CACHE_TTL_DAYS=90
# EVO_PARSE_ZIP_TTL_HOURS=6

# ── Chunking ────────────────────────────────────────────────────────────────
# Sizes are in characters. Blocks are never split below chunk_chars, so a table
# or long paragraph stays whole.
# EVO_CHUNK_CHARS=1600
# EVO_CHUNK_OVERLAP_CHARS=200
# EVO_CHUNK_MIN_CHARS=160

# ── Modal CPU parse service ──────────────────────────────────────────────────
# Marker hybrid + RapidOCR on scanned pages. One app, one deploy:
#   pnpm run deploy:modal
MODAL_FAST_PARSE_URL=       # ...--evo-mineru-fast.modal.run
# MODAL_PARSE_URL=          # alias if FAST is unset
MODAL_PARSE_TOKEN=
# Generous on purpose: a request can queue behind other documents sharing the
# container before its own parse starts.
MODAL_PARSE_TIMEOUT=900
EVO_PARSE_METHOD=ocr
# Must match modal/parse_common.py: 12 boxes × 6 digital = 72.
# EVO_PARSE_FAST_SLOTS=72

# ── Embeddings: OpenRouter (OpenAI-compatible /embeddings) ──────────────────
# Credentials only. WHICH embedding model runs is not configurable here: each
# workspace pins one at creation (workspaces.embedding_model_key) and keeps it
# for life, because its chunks live in that model's vector space and there is no
# reindex job. Change the default by adding a model_configs row and a vector
# table. One env pair for every embedding row; catalog base_url wins when set.
# OPENROUTER_* is the previous name and still accepted.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIM=2560
# EVO_EMBEDDING_BATCH=64

# ── Text LLM: DeepSeek (OpenAI-compatible) ──────────────────────────────────
# Ingest summaries and concept extraction resolve their model from the job's
# pin, so there is no env override for them. EVO_QUERY_MODEL is only the
# last-resort id for a call handed a bare model string.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
EVO_QUERY_MODEL=deepseek-v4-flash

# ── Retrieval tuning ────────────────────────────────────────────────────────
# EVO_SEARCH_CANDIDATES=40    # per-branch candidates before rank fusion
# EVO_SEARCH_TOP_K=8          # passages handed to the model
# EVO_SEARCH_PER_FILE_CAP=3   # stops one long document flooding a result set
# EVO_AGENT_MAX_STEPS=12      # tool-calling rounds per chat turn
# EVO_LLM_INPUT_BUDGET_TOKENS=50000  # fallback when a catalog row has no context_window_tokens

# ── Vision / image captions: Gemini (OpenAI-compatible endpoint) ────────────
# Captioning is chosen per file at upload time. Every figure that survives the
# filters in pipeline/parse/figures.py is described — the filters, not a count,
# are what bound the cost.
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Fallback for jobs that carry no per-file choice (older jobs, cloud imports).
# EVO_CAPTION_IMAGES=false
# EVO_CAPTION_CONCURRENCY=8   # wall clock, not price, is the binding constraint
# EVO_CAPTION_MAX_EDGE=1280   # longest edge sent to the model
# EVO_CAPTION_MAX_PER_FILE=0  # safety valve for a pathological file; 0 = off
# EVO_CAPTION_VERSION=v1      # bump to invalidate every cached caption
