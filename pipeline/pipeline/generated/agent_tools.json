{
  "version": 28,
  "operations": [
    "source.read",
    "material.read",
    "material.create",
    "document.edit",
    "resource.trash",
    "trash.read",
    "trash.restore",
    "library.read"
  ],
  "outcomes": [
    "succeeded",
    "refused",
    "failed",
    "cancelled",
    "outcome_unknown"
  ],
  "errorCodes": [
    "unsupported_format",
    "unsupported_operation",
    "invalid_input",
    "unavailable_target",
    "stale_target",
    "quota_rejected",
    "lifecycle_rejected",
    "outcome_unknown",
    "limit_reached",
    "office_editing_paused"
  ],
  "effectOperations": [
    "created",
    "edited",
    "edit_undone",
    "trashed",
    "restored"
  ],
  "tools": [
    {
      "name": "search_workspace",
      "version": 1,
      "description": "Search the learner's sources for passages matching one focused query.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "file_ids": {
            "description": "Restrict to these files. Omit to search the current scope.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": true,
      "concurrency": "search",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "cited_passages"
    },
    {
      "name": "list_sources",
      "version": 1,
      "description": "List the workspace's source files and study materials by chapter, with ids, kinds, editability and passage counts.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read",
        "material.read"
      ],
      "retention": "full"
    },
    {
      "name": "read_document",
      "version": 1,
      "description": "Read a source file or note in order from a chunk index: a passage's surrounding argument, or a short document end to end.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 4,
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "file_id"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "cited_passages"
    },
    {
      "name": "capture_page",
      "version": 1,
      "description": "Render a source page a shown passage cites, or a region of it, as an image you read directly. An uploaded image is page 1.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "[x0, y0, x1, y1] on a 0-1000 page grid, top-left origin, to zoom into a table, figure or formula.",
            "items": {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "file_id",
          "page"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_study_progress",
      "version": 1,
      "description": "Read the learner's study progress in this workspace: files and materials done or started, recent quiz results, and the chapters they retain least.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "full"
    },
    {
      "name": "search_knowledge",
      "version": 1,
      "description": "Search the shared library of verified textbook excerpts, one section of one book each. A hit is a selection aid; read_knowledge reads the excerpt.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "minLength": 1,
            "type": "string"
          },
          "roles": {
            "description": "What the excerpts teach.",
            "items": {
              "enum": [
                "introduction",
                "formal",
                "worked_example",
                "exercise",
                "summary",
                "reference"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "type": "array"
          },
          "subject": {
            "description": "A subject id listed below: search only its excerpts.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": true,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_knowledge",
      "version": 1,
      "description": "Read an excerpt's reviewed notes and source chunks in order from a chunk index; the notes and scope come on its first page.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 12,
            "description": "Chunks per page, at most 12.",
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "excerpt_id": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "excerpt_id"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "used_excerpts"
    },
    {
      "name": "capture_knowledge_page",
      "version": 1,
      "description": "Render a printed page an excerpt covers, or a region of it, as an image you read directly.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "[x0, y0, x1, y1] on a 0-1000 page grid, top-left origin, to zoom into a table, figure or formula.",
            "items": {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "excerpt_id": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "excerpt_id",
          "page"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_skill",
      "version": 1,
      "description": "Read a skill: the full instructions for one kind of work, listed below with when to read it. Read it before that work.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "A skill name listed below.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "none"
    },
    {
      "name": "create_material",
      "version": 1,
      "description": "Create a study material from content you wrote, in the formats the materials skill describes. A quiz is made with add_questions.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cards": {
            "description": "flashcards only",
            "items": {
              "additionalProperties": false,
              "properties": {
                "back": {
                  "maxLength": 2000,
                  "type": "string"
                },
                "front": {
                  "maxLength": 4000,
                  "type": "string"
                }
              },
              "required": [
                "front",
                "back"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "chapter_id": {
            "description": "The chapter to file it in; omit to leave it unfiled.",
            "minLength": 1,
            "type": "string"
          },
          "content": {
            "description": "note, mindmap or diagram only: markdown.",
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpts it was written from; they become its attribution. Optional; omitted, the excerpts read since your last write are credited.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "kind": {
            "enum": [
              "flashcards",
              "mindmap",
              "diagram",
              "note"
            ],
            "type": "string"
          },
          "scope": {
            "additionalProperties": false,
            "description": "Source scope for the material. Omit or leave empty to use the current chat scope.",
            "properties": {
              "chapter_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "file_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "add_questions",
      "version": 1,
      "description": "Add questions to a quiz (quiz_id), or create a quiz with them (title). A question's fields make its kind: multiple choice (options, one correct) and short answer (accepted) are 1 mark each; an open question, answered in writing, has marks and a markscheme adding up to them, and a model_answer. The result lists each question's id. Example: {\"title\": \"Osmosis\", \"questions\": [{\"question\": \"Which way does water move when a red blood cell is put in pure water?\", \"options\": [\"Into the cell\", \"Out of the cell\"], \"correct\": \"Into the cell\", \"explanation\": \"From the higher water potential outside.\"}, {\"question\": \"What percentage of NaCl is normal saline?\", \"accepted\": [\"0.9\"], \"unit\": \"%\"}, {\"question\": \"Explain why the cell bursts.\", \"marks\": 2, \"markscheme\": [{\"text\": \"Water enters by osmosis\", \"marks\": 1}, {\"text\": \"No cell wall resists the swelling\", \"marks\": 1}], \"model_answer\": \"Water enters by osmosis and, with no cell wall to resist it, the membrane ruptures.\"}]}",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "after_question_id": {
            "description": "Add after this question, not at the end.",
            "minLength": 1,
            "type": "string"
          },
          "chapter_id": {
            "description": "With title: the new quiz's chapter.",
            "minLength": 1,
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpts the questions were written from. Optional; omitted, the excerpts read since your last write are credited.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "questions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "accepted": {
                  "description": "Short answer: the accepted answers.",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "correct": {
                  "description": "Multiple choice: the one correct option, copied exactly.",
                  "type": "string"
                },
                "explanation": {
                  "description": "Optional: why the answer is right or the worked solution, shown after checking.",
                  "type": "string"
                },
                "hints": {
                  "description": "Open, optional: nudges the learner may open.",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 0,
                  "type": "array"
                },
                "marks": {
                  "description": "Open: its marks.",
                  "maximum": 20,
                  "minimum": 1,
                  "type": "integer"
                },
                "markscheme": {
                  "description": "Open: what earns marks, the items' marks adding up to marks.",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "marks": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "text": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "text",
                      "marks"
                    ],
                    "type": "object"
                  },
                  "maxItems": 5,
                  "minItems": 1,
                  "type": "array"
                },
                "model_answer": {
                  "description": "Open: a full-marks answer.",
                  "maxLength": 5000,
                  "type": "string"
                },
                "options": {
                  "description": "Multiple choice: the options.",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 2,
                  "type": "array"
                },
                "question": {
                  "description": "The question as the learner reads it.",
                  "type": "string"
                },
                "replaces": {
                  "description": "A question of the quiz to rewrite in place instead (its media is dropped).",
                  "minLength": 1,
                  "type": "string"
                },
                "unit": {
                  "description": "Short answer to a quantity: the unit shown after the box; accepted then holds plain numbers only, like \"9.8\".",
                  "type": "string"
                }
              },
              "required": [
                "question"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          },
          "quiz_id": {
            "description": "The quiz to add to, a note's quiz too; add_questions' result gives a new quiz's id.",
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "description": "Instead of quiz_id: create a quiz with this title.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "questions"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "add_question_media",
      "version": 1,
      "description": "Add a chart, a plot or a library figure to one quiz question, shown after its text. A figure is one read_knowledge listed this turn: {\"type\": \"figure\", \"id\": \"\u003cfigure id\u003e\", \"caption\": \"what it shows\"}; the question shows it with its printed credit and the quiz credits its book. Example: {\"quiz_id\": \"mat_1\", \"question_id\": \"q_3f9a1c2b7e\", \"media\": {\"type\": \"plot\", \"title\": \"Action potential\", \"xTitle\": \"Time (ms)\", \"yTitle\": \"Membrane potential (mV)\", \"series\": [{\"name\": \"Vm\", \"points\": [[0, -70], [1, 30], [2, -80], [4, -70]]}]}}",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "excerpt_ids": {
            "description": "Library excerpts the media was drawn from. Optional; omitted, the excerpts read since your last write are credited.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "media": {
            "additionalProperties": true,
            "description": "A note's chart or plot fence JSON, or a library figure.",
            "type": "object"
          },
          "question_id": {
            "minLength": 1,
            "type": "string"
          },
          "quiz_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "quiz_id",
          "question_id",
          "media"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "document.edit"
      ],
      "retention": "full"
    },
    {
      "name": "create_deck",
      "version": 1,
      "description": "Create a slide deck from an outline, one title and brief per slide, as the deck skill describes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "chapter_id": {
            "description": "The chapter to file the deck in; omit to leave it unfiled.",
            "minLength": 1,
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpts this was written from; they become the deck's Sources slide. Optional; omitted, the excerpts read since your last write are credited.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "slides": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "brief": {
                  "maxLength": 1200,
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "title",
                "brief"
              ],
              "type": "object"
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "title",
          "slides"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "write_slide",
      "version": 1,
