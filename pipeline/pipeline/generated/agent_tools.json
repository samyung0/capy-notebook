{
  "version": 8,
  "operations": [
    "source.read",
    "material.read",
    "material.create",
    "document.edit",
    "resource.trash",
    "trash.read",
    "trash.restore",
    "library.read"
  ],
  "outcomes": [
    "succeeded",
    "refused",
    "failed",
    "cancelled",
    "outcome_unknown"
  ],
  "errorCodes": [
    "unsupported_format",
    "unsupported_operation",
    "invalid_input",
    "unavailable_target",
    "stale_target",
    "quota_rejected",
    "lifecycle_rejected",
    "outcome_unknown",
    "limit_reached"
  ],
  "effectOperations": [
    "created",
    "edited",
    "edit_undone",
    "trashed",
    "restored"
  ],
  "tools": [
    {
      "name": "search_workspace",
      "version": 1,
      "description": "Search the user's sources for passages relevant to a query. One call per assistant message, with one focused query. Search again in a later step rather than concatenating several questions.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "file_ids": {
            "description": "Restrict to these files. Omit to search the current scope.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": true,
      "concurrency": "search",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "cited_passages"
    },
    {
      "name": "list_sources",
      "version": 1,
      "description": "List source files by chapter and workspace study materials, with ids, resource kinds and editability. Source files include passage counts and short descriptors.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read",
        "material.read"
      ],
      "retention": "full"
    },
    {
      "name": "read_document",
      "version": 1,
      "description": "Read a source file or note in order from a given chunk index. Use after search when a passage needs its surrounding argument, or to walk a short document end to end.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 4,
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "file_id"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "cited_passages"
    },
    {
      "name": "capture_page",
      "version": 1,
      "description": "Render one source page, or a boxed region of it, and read it directly as an image. Use the file_id and 1-based page shown with a passage; only pages a shown passage cites can be captured. bbox is optional: [x0, y0, x1, y1] on a 0-1000 grid over the page, origin top-left, to zoom into a table, figure or formula. An uploaded image is one page: capture page 1 to see it; on a low-resolution image a bbox crops without adding detail, so the zoom may not help. Costs one tool call and a few seconds.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "Region to zoom into on the 0-1000 page grid, top-left origin.",
            "items": {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "file_id",
          "page"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "none"
    },
    {
      "name": "search_knowledge",
      "version": 1,
      "description": "Search the shared knowledge library of verified textbook excerpts. One excerpt is one section of one book. `roles` filters what the excerpt teaches: introduction, formal, worked_example, exercise, summary, reference. `topics` takes exact topic_id values returned by browse_knowledge with a subject. Subject IDs and labels are not topic filters; omit topics for a direct search. An empty result under a role filter reports what those topics do hold by role, so relax the filter on purpose instead of rewording.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "minLength": 1,
            "type": "string"
          },
          "roles": {
            "description": "Excerpt roles to restrict to.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 6,
            "type": "array"
          },
          "topics": {
            "description": "Exact topic_id values returned by browse_knowledge with a subject. Subject IDs and labels are not accepted. Omit for a direct search.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": true,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "browse_knowledge",
      "version": 1,
      "description": "List what the library holds. Pass exactly one of subject or topic. Use a subject browse call listed below to retrieve its topics with excerpt counts. Subject IDs are only for subject; use the returned topic_id values in search_knowledge.topics or this tool's topic. A topic ID returns verified excerpt counts by role and by book, then a page of excerpts with their section paths and reviewed scope. A direct search needs no preceding browse.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "default": 1,
            "minimum": 1,
            "type": "integer"
          },
          "subject": {
            "description": "Subject ID from a browse call in this tool's description. Retrieves topic IDs for search_knowledge.topics.",
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "description": "Exact topic_id returned by a subject browse. Retrieves excerpt coverage; do not pass a subject ID or label.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_knowledge",
      "version": 1,
      "description": "Read a library excerpt in full, in order from a chunk index. Always read an excerpt before writing a material from it; a search hit is one chunk of it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "excerpt_id": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "excerpt_id"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "used_excerpts"
    },
    {
      "name": "capture_knowledge_page",
      "version": 1,
      "description": "Render one printed page of the book an excerpt comes from, or a boxed region of it, and read it directly as an image. Only pages the excerpt covers, or the page of one of its figures, can be captured. bbox is optional: [x0, y0, x1, y1] on a 0-1000 grid over the page, origin top-left, to zoom into a figure, table or formula. Use it when the text of an excerpt does not carry the layout the material needs.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "Region to zoom into on the 0-1000 page grid, top-left origin.",
            "items": {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "excerpt_id": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "excerpt_id",
          "page"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "create_ledger",
      "version": 1,
      "description": "Create or update the conversation's progress ledger. A non-null body replaces the current body; null or omission preserves it. Each string in todos adds a new todo with an assigned ID. An object {id, todo} adds that ID or overwrites its text. Use fresh IDs for new todos; completed IDs are not reused. Unmentioned todos stay unchanged. Pass only additions or edits, not the whole list. You may correct the ledger again in the same turn. At most 10 unfinished todos may exist, each a material or section to write. Material writes mark their todo done automatically; editing todo text does not change completion.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "maxLength": 2000,
            "type": [
              "string",
              "null"
            ]
          },
          "todos": {
            "items": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "todo": {
                      "maxLength": 200,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "todo"
                  ],
                  "type": "object"
                }
              ]
            },
            "maxItems": 10,
            "type": "array"
          }
        },
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "create_material",
      "version": 1,
      "description": "Create a study material in this workspace from content you already authored: a quiz, flashcard deck, mindmap, diagram or note. Only call this when the user asked for one. Ground the content in passages you already retrieved. Do not mix this call with retrieval tools in the same response.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cards": {
            "description": "flashcards only",
            "items": {
              "additionalProperties": false,
              "properties": {
                "back": {
                  "type": "string"
                },
                "front": {
                  "type": "string"
                }
              },
              "required": [
                "front",
                "back"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "content": {
            "description": "mindmap/diagram/note only; markdown with a mermaid block",
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpt ids this material was written from. Required for every material built from the knowledge library; they become its attribution footer.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "kind": {
            "enum": [
              "quiz",
              "flashcards",
              "mindmap",
              "diagram",
              "note"
            ],
            "type": "string"
          },
          "questions": {
            "description": "quiz only; same shape as the quiz generator",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "scope": {
            "additionalProperties": false,
            "description": "Source scope for the material. Omit or leave empty to use the current chat scope.",
            "properties": {
              "chapter_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "file_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          },
          "todo": {
            "description": "Curate mode: id of the ledger todo this write completes, as shown on the ledger.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "resolve_source_change",
      "version": 1,
      "description": "Describe an added or changed source image from an exact pending-change placeholder. Only use identifiers supplied in the pending-source evidence.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "minLength": 1,
            "type": "string"
          },
          "checkpoint": {
            "minimum": 0,
            "type": "integer"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "change_id",
          "checkpoint"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "full"
    },
    {
      "name": "inspect_document",
      "version": 1,
      "description": "Read the current authoritative content of one document as editable targets: Plate blocks with stable block ids, text lines with offsets, DOCX/PPTX paragraphs or XLSX cells with stable ids. Always inspect before editing; never derive edit positions from search results.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 60,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "start": {
            "default": 0,
            "description": "First target index to return.",
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "additionalProperties": false,
            "description": "The document to inspect.",
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source_file",
                  "material"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read",
        "material.read"
      ],
      "retention": "full"
    },
    {
      "name": "edit_document",
      "version": 1,
      "description": "Apply content edits to one inspected document. Each command names a stable target from inspect_document and the exact text or value it expects to find; the whole call is refused if any expectation is stale. Edits save directly and each result has an Undo the user can trigger. Formatting, images, media, layout and PDF edits are not supported.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "commands": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_text": {
                      "description": "Exact text to replace; must occur once in the target.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "target_id": {
                      "description": "Block, paragraph or shape target id; omit for a plain text source.",
                      "type": "string"
                    },
                    "text": {
                      "description": "Replacement text; empty deletes the expected text.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "type": {
                      "const": "replace_text"
                    }
                  },
                  "required": [
                    "type",
                    "expected_text",
                    "text"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "after_block_id": {
                      "description": "Insert after this block; null inserts at the start.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "text": {
                      "description": "Plain text; each line becomes a paragraph.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "type": {
                      "const": "insert_block"
                    }
                  },
                  "required": [
                    "type",
                    "after_block_id",
                    "text"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "block_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "expected_text": {
                      "description": "The block's current text.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "type": {
                      "const": "remove_block"
                    }
                  },
                  "required": [
                    "type",
                    "block_id",
                    "expected_text"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "cell": {
                      "description": "A1-style address.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "expected_value": {
                      "description": "Current value or =formula; empty for an empty cell.",
                      "type": "string"
                    },
                    "sheet": {
                      "description": "Sheet id or name from inspect_document.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": {
                      "const": "set_cell"
                    },
                    "value": {
                      "description": "New value; prefix with = for a formula; empty clears.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "sheet",
                    "cell",
                    "expected_value",
                    "value"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "back": {
                      "type": "string"
                    },
                    "card_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "front": {
                      "type": "string"
                    },
                    "type": {
                      "const": "replace_card"
                    }
                  },
                  "required": [
                    "type",
                    "card_id"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "after_card_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "back": {
                      "type": "string"
                    },
                    "front": {
                      "type": "string"
                    },
                    "type": {
                      "const": "add_card"
                    }
                  },
                  "required": [
                    "type",
                    "front",
                    "back"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "card_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": {
                      "const": "remove_card"
                    }
                  },
                  "required": [
                    "type",
                    "card_id"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "question": {
                      "additionalProperties": true,
                      "description": "Same shape as the quiz generator.",
                      "type": "object"
                    },
                    "question_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": {
                      "const": "replace_question"
                    }
                  },
                  "required": [
                    "type",
                    "question_id",
                    "question"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "after_question_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "question": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "type": {
                      "const": "add_question"
                    }
                  },
                  "required": [
                    "type",
                    "question"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "question_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": {
                      "const": "remove_question"
                    }
                  },
                  "required": [
                    "type",
                    "question_id"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_source": {
                      "description": "Current mermaid source.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "source": {
                      "description": "New mermaid source.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "type": {
                      "const": "set_mermaid"
                    }
                  },
                  "required": [
                    "type",
                    "expected_source",
                    "source"
                  ],
                  "type": "object"
                }
              ]
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array"
          },
          "excerpt_ids": {
            "description": "Curate mode: library excerpt ids the appended content was written from; they join the material's attribution footer.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "target": {
            "additionalProperties": false,
            "description": "The document to edit.",
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source_file",
                  "material"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          },
          "todo": {
            "description": "Curate mode: id of the ledger todo this write completes, as shown on the ledger.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "target",
          "commands"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "document.edit"
      ],
      "retention": "full"
    },
    {
      "name": "trash_file",
      "version": 1,
      "description": "Move a source file or study material in this workspace to the trash. Only call this when the user asked to delete or remove it. The owner can restore it from Files › Trash within 30 days.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "target": {
            "additionalProperties": false,
            "description": "The file or material to trash.",
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source_file",
                  "material"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
