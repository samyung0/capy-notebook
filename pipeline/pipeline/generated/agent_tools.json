{
  "version": 16,
  "operations": [
    "source.read",
    "material.read",
    "material.create",
    "document.edit",
    "resource.trash",
    "trash.read",
    "trash.restore",
    "library.read"
  ],
  "outcomes": [
    "succeeded",
    "refused",
    "failed",
    "cancelled",
    "outcome_unknown"
  ],
  "errorCodes": [
    "unsupported_format",
    "unsupported_operation",
    "invalid_input",
    "unavailable_target",
    "stale_target",
    "quota_rejected",
    "lifecycle_rejected",
    "outcome_unknown",
    "limit_reached",
    "office_editing_paused"
  ],
  "effectOperations": [
    "created",
    "edited",
    "edit_undone",
    "trashed",
    "restored"
  ],
  "tools": [
    {
      "name": "search_workspace",
      "version": 1,
      "description": "Search the learner's sources for passages matching one focused query.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "file_ids": {
            "description": "Restrict to these files. Omit to search the current scope.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": true,
      "concurrency": "search",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "cited_passages"
    },
    {
      "name": "list_sources",
      "version": 1,
      "description": "List the workspace's source files and study materials by chapter, with ids, kinds, editability and passage counts.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read",
        "material.read"
      ],
      "retention": "full"
    },
    {
      "name": "read_document",
      "version": 1,
      "description": "Read a source file or note in order from a chunk index: a passage's surrounding argument, or a short document end to end.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 4,
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "file_id"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "cited_passages"
    },
    {
      "name": "capture_page",
      "version": 1,
      "description": "Render a source page a shown passage cites, or a region of it, as an image you read directly. An uploaded image is page 1.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "[x0, y0, x1, y1] on a 0-1000 page grid, top-left origin, to zoom into a table, figure or formula.",
            "items": {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "file_id",
          "page"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_study_progress",
      "version": 1,
      "description": "Read the learner's study progress in this workspace: files and materials done or started, recent quiz results, and the chapters they retain least.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "full"
    },
    {
      "name": "search_knowledge",
      "version": 1,
      "description": "Search the shared library of verified textbook excerpts, one section of one book each. A hit is a selection aid; read_knowledge reads the excerpt.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "book": {
            "description": "A book id from a result header: search only that book.",
            "minLength": 1,
            "type": "string"
          },
          "query": {
            "minLength": 1,
            "type": "string"
          },
          "roles": {
            "description": "What the excerpts teach.",
            "items": {
              "enum": [
                "introduction",
                "formal",
                "worked_example",
                "exercise",
                "summary",
                "reference"
              ],
              "type": "string"
            },
            "maxItems": 6,
            "type": "array"
          },
          "section": {
            "description": "A section path from a result: search only that section and the ones under it.",
            "minLength": 1,
            "type": "string"
          },
          "topics": {
            "description": "topic_id values from a browse_knowledge subject; omit for a direct search.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": true,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "browse_knowledge",
      "version": 1,
      "description": "List what the library holds: a subject listed below for its topics with excerpt counts, or a topic for its excerpts by role and book.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "book": {
            "description": "A book id: its outline of section paths with pages.",
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "type": "integer"
          },
          "subject": {
            "description": "A subject id listed below.",
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "description": "A topic_id from a subject browse.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_knowledge",
      "version": 1,
      "description": "Read an excerpt's reviewed notes and source chunks in order from a chunk index; the notes and scope come on its first page.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "book": {
            "description": "With section, instead of excerpt_id: the book to read a section of.",
            "minLength": 1,
            "type": "string"
          },
          "count": {
            "description": "Chunks per page: at most and by default 12 of an excerpt, 24 of a section.",
            "maximum": 24,
            "minimum": 1,
            "type": "integer"
          },
          "excerpt_id": {
            "minLength": 1,
            "type": "string"
          },
          "section": {
            "description": "A section path from the book's outline: read it in order, subsections included.",
            "minLength": 1,
            "type": "string"
          },
          "start": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "used_excerpts"
    },
    {
      "name": "list_question_bank",
      "version": 1,
      "description": "List the question bank of reviewed exam questions: a bank subject listed below for its topics, or a topic for its questions as cards, 50 per page, optionally only those with a part of one answer type.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "answer_type": {
            "description": "With topic: only questions with a part of this answer type, as cards list them after their marks (True/False/Not given items are mcq).",
            "enum": [
              "mcq",
              "multi",
              "boolean",
              "short",
              "matching",
              "ordering",
              "open",
              "gaps"
            ],
            "type": "string"
          },
          "offset": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          },
          "subject": {
            "description": "A bank subject id from this description.",
            "minLength": 1,
            "type": "string"
          },
          "topic": {
            "description": "A topic id from a subject's list.",
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_question",
      "version": 1,
      "description": "Read one question-bank question with its sources: in full (answer key, solution, marking scheme) when the user edits the bank, otherwise without answers. copy_questions copies the answers either way.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "question_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "question_id"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "full"
    },
    {
      "name": "copy_questions",
      "version": 1,
      "description": "Copy question-bank questions by id, unchanged, into a new quiz (title, optional chapter_id) or a quiz in this workspace (quiz_id), instead of writing them out.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "chapter_id": {
            "description": "The chapter to file a new quiz in.",
            "minLength": 1,
            "type": "string"
          },
          "question_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "quiz_id": {
            "description": "A quiz in this workspace to append to.",
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "todo": {
            "description": "The open ledger todo this write completes.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "question_ids"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create",
        "library.read"
      ],
      "retention": "full"
    },
    {
      "name": "capture_knowledge_page",
      "version": 1,
      "description": "Render a printed page an excerpt covers, or a region of it, as an image you read directly.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bbox": {
            "description": "[x0, y0, x1, y1] on a 0-1000 page grid, top-left origin, to zoom into a table, figure or formula.",
            "items": {
              "maximum": 1000,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "excerpt_id": {
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "excerpt_id",
          "page"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "library.read"
      ],
      "retention": "none"
    },
    {
      "name": "read_skill",
      "version": 1,
      "description": "Read a skill: the full instructions for one kind of work, listed below with when to read it. Read it before that work.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "A skill name listed below.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "none"
    },
    {
      "name": "create_ledger",
      "version": 1,
      "description": "Add or edit the conversation's ledger todos, one per item to write: a string adds a todo, {id, todo} rewrites one. Pass only the changes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "todos": {
            "items": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "todo": {
                      "maxLength": 200,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "todo"
                  ],
                  "type": "object"
                }
              ]
            },
            "maxItems": 10,
            "type": "array"
          }
        },
        "required": [
          "todos"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "none"
    },
    {
      "name": "create_material",
      "version": 1,
      "description": "Create a study material from content you wrote, in the formats the materials skill describes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cards": {
            "description": "flashcards only",
            "items": {
              "additionalProperties": false,
              "properties": {
                "back": {
                  "type": "string"
                },
                "front": {
                  "type": "string"
                }
              },
              "required": [
                "front",
                "back"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "chapter_id": {
            "description": "The chapter to file it in; omit to leave it unfiled.",
            "minLength": 1,
            "type": "string"
          },
          "content": {
            "description": "note, mindmap or diagram only: markdown.",
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpts it was written from; they become its attribution.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "kind": {
            "enum": [
              "quiz",
              "flashcards",
              "mindmap",
              "diagram",
              "note"
            ],
            "type": "string"
          },
          "questions": {
            "description": "quiz only: question JSON.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "scope": {
            "additionalProperties": false,
            "description": "Source scope for the material. Omit or leave empty to use the current chat scope.",
            "properties": {
              "chapter_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "file_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "title": {
            "maxLength": 120,
            "type": "string"
          },
          "todo": {
            "description": "The open ledger todo this write completes.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "create_deck",
      "version": 1,
      "description": "Create a slide deck from an outline, one title and brief per slide, as the deck skill describes.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "chapter_id": {
            "description": "The chapter to file the deck in; omit to leave it unfiled.",
            "minLength": 1,
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpts this was written from; they become the deck's Sources slide.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "slides": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "brief": {
                  "maxLength": 1200,
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "title",
                "brief"
              ],
              "type": "object"
            },
            "maxItems": 30,
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "todo": {
            "description": "The open ledger todo this write completes.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "title",
          "slides"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "write_slide",
      "version": 1,
      "description": "Write one slide of a deck as SVG in the deck skill's rules; writing a slide again replaces it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "deck_id": {
            "minLength": 1,
            "type": "string"
          },
          "excerpt_ids": {
            "description": "Library excerpts this was written from; they become the deck's Sources slide.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "slide": {
            "minimum": 1,
            "type": "integer"
          },
          "svg": {
            "maxLength": 40000,
            "minLength": 1,
            "type": "string"
          },
          "todo": {
            "description": "The open ledger todo this write completes.",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "deck_id",
          "slide",
          "svg"
        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "resolve_source_change",
      "version": 1,
      "description": "See an added or changed source image from an exact pending-change placeholder; the image is attached to the next message. Only use identifiers supplied in the pending-source evidence.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "minLength": 1,
            "type": "string"
          },
          "checkpoint": {
            "minimum": 0,
            "type": "integer"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "file_id",
          "change_id",
          "checkpoint"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "none"
    },
    {
      "name": "inspect_document",
      "version": 1,
      "description": "Read a document's current content as editable targets with stable ids. Inspect before editing; never take edit positions from search results. A quiz's answers, solutions and marking schemes appear only when the user may edit it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 60,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "start": {
            "default": 0,
            "description": "First target index to return.",
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "additionalProperties": false,
            "description": "The document to inspect.",
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source_file",
                  "material"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read",
        "material.read"
      ],
      "retention": "full"
    },
    {
      "name": "edit_document",
      "version": 1,
      "description": "Edit the content of one inspected document: each command names a target and the exact text or value it expects, and one stale expectation refuses the whole call. Edits save directly, each with an Undo; no formatting, media or PDF edits.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "commands": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_text": {
                      "description": "Exact text to replace; must occur once in the target.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "target_id": {
                      "description": "Block, paragraph or shape target id; omit for a plain text source.",
                      "type": "string"
                    },
                    "text": {
                      "description": "Replacement text; empty deletes the expected text.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "type": {
                      "const": "replace_text"
                    }
                  },
