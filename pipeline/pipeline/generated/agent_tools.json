      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read"
      ],
      "retention": "none"
    },
    {
      "name": "inspect_document",
      "version": 1,
      "description": "Read a document's current content as editable targets with stable ids. Inspect before editing; never take edit positions from search results. A quiz's answers, solutions and marking schemes appear only when the user may edit it.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "default": 60,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "start": {
            "default": 0,
            "description": "First target index to return.",
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "additionalProperties": false,
            "description": "The document to inspect.",
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "source_file",
                  "material"
                ],
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "mutates": false,
      "usesEmbedding": false,
      "concurrency": "read",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "source.read",
        "material.read"
      ],
      "retention": "full"
    },
    {
      "name": "edit_document",
      "version": 1,
      "description": "Edit the content of one inspected document: each command names a target and the exact text or value it expects, and one stale expectation refuses the whole call. Edits save directly, each with an Undo; replace_block rewrites a note block with formatting or math; no media or PDF edits. Quiz questions are added and replaced with the question tools.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "commands": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "expected_text": {
                      "description": "Exact text to replace as inspect_document shows it, without math; must occur once in the target.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "target_id": {
                      "description": "Block, paragraph or shape target id; omit for a plain text source.",
                      "type": "string"
                    },
                    "text": {
                      "description": "Plain replacement text; empty deletes the expected text.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "type": {
                      "const": "replace_text"
                    }
                  },
                  "required": [
                    "type",
                    "expected_text",
                    "text"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "block_id": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "expected_text": {
                      "description": "The block's current text as inspect_document shows it.",
                      "maxLength": 200000,
                      "type": "string"
                    },
                    "markdown": {
                      "description": "The block's new content as note markdown in the materials skill's format.",
