        ],
        "type": "object"
      },
      "mutates": true,
      "usesEmbedding": false,
      "concurrency": "mutate",
      "allowedSlots": [
        "chat"
      ],
      "requiredOperations": [
        "material.create"
      ],
      "retention": "full"
    },
    {
      "name": "resolve_source_change",
      "version": 1,
      "description": "See an added or changed source image from an exact pending-change placeholder; the image is attached to the next message. Only use identifiers supplied in the pending-source evidence.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "change_id": {
            "minLength": 1,
            "type": "string"
          },
          "checkpoint": {
            "minimum": 0,
            "type": "integer"
          },
          "file_id": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
