# Content-hashed bundles: Vite renames a changed file and never reuses a name.
# On the app hosts /assets/* is its own Worker (wrangler.assets.jsonc), which
# answers a name no file matches with 404 no-store, so no SPA index.html can
# sit under a chunk's URL (human/deployment-runbook.md, 2026-10-17).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The build's release (vite.config.ts), read by open tabs to learn a new app
# is served: never from a cache.
/release.txt
  Cache-Control: no-store

# Avatar and workspace icons keep their names, and their artwork is stable:
# cached for a year like /assets/*, so a changed icon can stay stale.
/icons/*
  Cache-Control: public, max-age=31536000, immutable
