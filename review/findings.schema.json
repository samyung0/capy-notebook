{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evo-notes.local/review/findings.schema.json",
  "title": "Evo Notes adversarial review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "mode",
    "startedAt",
    "scope",
    "engines",
    "commands",
    "challenge",
    "findings",
    "coverageGaps",
    "limitations",
    "recommendation"
  ],
  "properties": {
    "revision": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["source", "uat", "release"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } }
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "status": {
            "enum": ["completed", "failed", "unavailable", "skipped"]
          },
          "artifact": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageGap" }
    },
    "commands": { "type": "array", "items": { "type": "string" } },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "crossModel"],
      "properties": {
        "independent": { "type": "boolean" },
        "crossModel": { "type": "boolean" },
        "model": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "recommendation": {
      "enum": [
        "release recommended",
        "release conditionally recommended",
        "release not recommended",
        "insufficient evidence"
      ]
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "confidence",
        "status",
        "title",
        "invariant",
        "scenario",
        "impact",
        "evidence",
        "reproduction",
        "controlsConsidered",
        "remediation",
        "regressionTest",
        "challengerVerdict"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": {
          "enum": ["critical", "high", "medium", "low", "informational"]
        },
        "confidence": { "enum": ["high", "medium", "low"] },
        "status": { "enum": ["validated", "disputed"] },
        "title": { "type": "string", "minLength": 1 },
        "invariant": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "reproduction": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "controlsConsidered": {
          "type": "array",
          "items": { "type": "string" }
        },
        "remediation": { "type": "string", "minLength": 1 },
        "regressionTest": { "type": "string", "minLength": 1 },
        "challengerVerdict": { "type": "string", "minLength": 1 }
      }
    },
    "coverageGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "reason", "needed"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "needed": { "type": "string", "minLength": 1 }
      }
    }
  }
}
