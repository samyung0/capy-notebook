{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The app hosts' /assets/* route: the SPA build's content-hashed files as
  // static assets (immutable, public/_headers) and, for a name no file
  // matches, workers/site/assets.ts (404, no-store). Its routes are more
  // specific than the app Worker's, so the app Worker never answers
  // /assets/*. The deploy stages dist/assets and dist/_headers, passes them
  // with --assets, and publishes before the app Worker.
  "name": "capy-notebook-assets",
  "main": "workers/site/assets.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "env": {
    "uat": {
      "name": "capy-notebook-assets-uat",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "routes": [
        {
          "pattern": "uat-app.capynotebook.com/assets/*",
          "zone_name": "capynotebook.com"
        },
        {
          "pattern": "app.uat.capynotebook.com/assets/*",
          "zone_name": "capynotebook.com"
        },
        {
          "pattern": "uat.capynotebook.com/assets/*",
          "zone_name": "capynotebook.com"
        }
      ]
    },
    "production": {
      "name": "capy-notebook-assets-production",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "html_handling": "none",
        "not_found_handling": "none"
      },
      "routes": [
        {
          "pattern": "app.capynotebook.com/assets/*",
          "zone_name": "capynotebook.com"
        }
      ]
    }
  }
}
