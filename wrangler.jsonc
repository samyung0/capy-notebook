{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capy-notebook",
  "main": "workers/site/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/w/*",
      "/share/workspaces/*",
      "/summary",
      "/summary.html",
      "/llm-runtime.html"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_ORIGIN": "http://localhost:8080",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "env": {
    "uat": {
      "name": "capy-notebook-uat",
      "vars": {
        "API_ORIGIN": "",
        "APP_ORIGIN": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/w/*",
          "/share/workspaces/*",
          "/summary",
          "/summary.html",
          "/llm-runtime.html"
        ]
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "uat.capynotebook.com",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "capy-notebook-production",
      "vars": {
        "API_ORIGIN": "",
        "APP_ORIGIN": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/w/*",
          "/share/workspaces/*",
          "/summary",
          "/summary.html",
          "/llm-runtime.html"
        ]
      }
    }
  }
}
