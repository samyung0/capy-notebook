{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capy-notebook",
  "main": "workers/site/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/w/*", "/summary", "/summary.html"]
  },
  "observability": {
    "enabled": true
  },
  // Signs /w/ summary links with the Go API's SHARE_LINK_SECRET. Not inherited,
  // so each environment repeats it; CI supplies it with --secrets-file.
  "secrets": { "required": ["SHARE_LINK_SECRET"] },
  "vars": {
    "API_ORIGIN": "http://localhost:8080",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "env": {
    "uat": {
      "name": "capy-notebook-uat",
      "secrets": { "required": ["SHARE_LINK_SECRET"] },
      "vars": {
        "API_ORIGIN": "",
        "APP_ORIGIN": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/w/*", "/summary", "/summary.html"]
      },
      "workers_dev": false,
      "preview_urls": false,
      // Both app hosts point to capy-uat and need separate scriptless /api/* routes.
      // Keep the old host for browser draft recovery until the runbook §1.0.2 cutover.
      "routes": [
        {
          "pattern": "app.uat.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        },
        {
          "pattern": "uat.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        }
      ]
    },
    "production": {
      "name": "capy-notebook-production",
      "secrets": { "required": ["SHARE_LINK_SECRET"] },
      "workers_dev": false,
      "preview_urls": false,
      // Provision tunnel-backed DNS and a scriptless app.capynotebook.com/api/*
      // zone route before first deployment. The apex belongs to the public site.
      "routes": [
        {
          "pattern": "app.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        }
      ],
      "vars": {
        "API_ORIGIN": "",
        "APP_ORIGIN": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/w/*", "/summary", "/summary.html"]
      }
    }
  }
}
