{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capy-notebook",
  "main": "workers/site/index.ts",
  // The share page renderer, built by `vite build --ssr` (vite.config.ts).
  "alias": { "capy-share-render": "./dist/_ssr/server.js" },
  // A smaller script for every new isolate to load and compile (7.5 MB
  // unminified, 3.8 MB minified).
  "minify": true,
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  // Off at the top level too, so a deploy without --env never publishes a
  // workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/w/*",
      "/p/*",
      "/share/*",
      "/summary",
      "/summary.html",
      "/share.html"
    ]
  },
  "observability": {
    "enabled": true
  },
  // Workers Cache sits in front of the Worker and honours each response's
  // Cache-Control: shared pages (`s-maxage=300`) are served without running the
  // Worker; everything else is `no-store`. Inherited by every environment.
  "cache": {
    "enabled": true
  },
  // Signs /w/ summary links with the Go API's SHARE_LINK_SECRET. Not inherited,
  // so each environment repeats it; CI supplies it with --secrets-file.
  "secrets": { "required": ["SHARE_LINK_SECRET"] },
  "vars": {
    "API_ORIGIN": "http://localhost:8080",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "env": {
    "uat": {
      "name": "capy-notebook-uat",
      "secrets": { "required": ["SHARE_LINK_SECRET"] },
      "vars": {
        "API_ORIGIN": "",
        "APP_ORIGIN": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/w/*",
          "/p/*",
          "/share/*",
          "/summary",
          "/summary.html",
          "/share.html"
        ]
      },
      // Run the Worker beside the UAT VM (Netcup, Germany). Its one API read
      // goes through the Cloudflare Tunnel, which costs about three round
      // trips from a distant Worker (measured from Tokyo 2026-10-12: about
      // 750 ms unpinned, 95 ms pinned). Cache hits still come from the
      // nearest edge.
      "placement": { "region": "aws:eu-central-1" },
      "workers_dev": false,
      "preview_urls": false,
      // Every app host points to capy-uat and needs its own scriptless /api/* route.
      // uat-app replaces app.uat (Q291); the old hosts stay until the runbook §1.0.2 cutover.
      // Each host's /assets/* belongs to the assets Worker (wrangler.assets.jsonc).
      "routes": [
        {
          "pattern": "uat-app.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        },
        {
          "pattern": "app.uat.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        },
        {
          "pattern": "uat.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        }
      ]
    },
    "production": {
      "name": "capy-notebook-production",
      "secrets": { "required": ["SHARE_LINK_SECRET"] },
      "workers_dev": false,
      "preview_urls": false,
      // Provision tunnel-backed DNS and a scriptless app.capynotebook.com/api/*
      // zone route before first deployment. The apex belongs to the public site.
      // /assets/* belongs to the assets Worker (wrangler.assets.jsonc).
      "routes": [
        {
          "pattern": "app.capynotebook.com/*",
          "zone_name": "capynotebook.com"
        }
      ],
      "vars": {
        "API_ORIGIN": "",
        "APP_ORIGIN": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/w/*",
          "/p/*",
          "/share/*",
          "/summary",
          "/summary.html",
          "/share.html"
        ]
      }
    }
  }
}
