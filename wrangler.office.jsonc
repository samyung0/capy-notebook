{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capy-notebook-office",
  "main": "workers/office/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/office-runtime.html",
      "/assets/*.wasm",
      "/assets/*.ttf",
      "/assets/*.otf"
    ]
  },
  "cache": {
    "enabled": true
  },
  "vars": {
    "PARENT_ORIGINS": ""
  },
  "env": {
    "uat": {
      "name": "capy-notebook-office-uat",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "PARENT_ORIGINS": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": [
          "/office-runtime.html",
          "/assets/*.wasm",
          "/assets/*.ttf",
          "/assets/*.otf"
        ]
      },
      "routes": [
        {
          "pattern": "uat-office.capynotebook.com",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "capy-notebook-office-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "office.capynotebook.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "PARENT_ORIGINS": ""
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "none",
        "not_found_handling": "none",
        "run_worker_first": [
          "/office-runtime.html",
          "/assets/*.wasm",
          "/assets/*.ttf",
          "/assets/*.otf"
        ]
      }
    }
  }
}
