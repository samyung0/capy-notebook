{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // UAT only: the journey inbox Email Routing delivers to
  // (openwiki/deployment-runbook.md §12.5). READ_TOKEN is a Worker secret.
  "name": "capy-notebook-uat-inbox",
  "main": "workers/uat-inbox/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "uat-inbox.capynotebook.com", "custom_domain": true }
  ],
  "vars": { "SENDER_DOMAIN": "uat.capynotebook.com" },
  "kv_namespaces": [
    { "binding": "INBOX", "id": "0dffc2fb465749d08849041171605ce7" }
  ]
}
